{% doc %}
  @prompt
    create a section that has one image with heading and text and stacked columns with text. I would like very little white space, eliminate the image and just keep heading with text and then I need 4 text columns with icons. Instead of stacked keep the icons as circles and in one horizontal line that is a slider on mobile. Can you add more icons including something for workforce development, skills development hours, recycle or upcycle icon and include a counter that goes up to 100000, I need another icon for lives impacted, update the items recycled icon to a normal recycle icon, work force development hours should be a heart, the icons should not be stacked on desktop or mobile, the text under the icon should be stacked
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-impact-stats-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-impact-stats__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-impact-stats__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.spacing }}px;
  }

  .ai-impact-stats__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
  }

  .ai-impact-stats__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.6;
  }

  .ai-impact-stats__grid-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-impact-stats__grid-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-impact-stats__grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.column_gap }}px;
    min-width: min-content;
  }

  .ai-impact-stats__item-{{ ai_gen_id }} {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 0 0 auto;
  }

  .ai-impact-stats__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.icon_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.icon_spacing }}px;
  }

  .ai-impact-stats__icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    stroke: {{ block.settings.icon_color }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-impact-stats__icon-{{ ai_gen_id }} svg.filled {
    fill: {{ block.settings.icon_color }};
    stroke: none;
  }

  .ai-impact-stats__counter-{{ ai_gen_id }} {
    font-size: {{ block.settings.counter_size }}px;
    font-weight: 700;
    color: {{ block.settings.counter_color }};
    margin: 0 0 {{ block.settings.label_spacing }}px;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
  }

  .ai-impact-stats__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    margin: 0;
    max-width: 150px;
    line-height: 1.4;
  }

  @media screen and (min-width: 750px) {
    .ai-impact-stats__grid-{{ ai_gen_id }} {
      justify-content: center;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-impact-stats__grid-{{ ai_gen_id }} {
      padding-bottom: 10px;
    }

    .ai-impact-stats__item-{{ ai_gen_id }} {
      min-width: 150px;
    }
  }
{% endstyle %}

<impact-stats-{{ ai_gen_id }} class="ai-impact-stats-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-impact-stats__container-{{ ai_gen_id }}">
    <div class="ai-impact-stats__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-impact-stats__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.text != blank %}
        <div class="ai-impact-stats__text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
      {% endif %}
    </div>

    <div class="ai-impact-stats__grid-wrapper-{{ ai_gen_id }}">
      <div class="ai-impact-stats__grid-{{ ai_gen_id }}">
        {% if block.settings.stat_1_enabled %}
          <div class="ai-impact-stats__item-{{ ai_gen_id }}">
            <div class="ai-impact-stats__icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <div class="ai-impact-stats__counter-{{ ai_gen_id }}" data-target="{{ block.settings.stat_1_number }}">0</div>
            <div class="ai-impact-stats__label-{{ ai_gen_id }}">{{ block.settings.stat_1_label }}</div>
          </div>
        {% endif %}

        {% if block.settings.stat_2_enabled %}
          <div class="ai-impact-stats__item-{{ ai_gen_id }}">
            <div class="ai-impact-stats__icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
              </svg>
            </div>
            <div class="ai-impact-stats__counter-{{ ai_gen_id }}" data-target="{{ block.settings.stat_2_number }}">0</div>
            <div class="ai-impact-stats__label-{{ ai_gen_id }}">{{ block.settings.stat_2_label }}</div>
          </div>
        {% endif %}

        {% if block.settings.stat_3_enabled %}
          <div class="ai-impact-stats__item-{{ ai_gen_id }}">
            <div class="ai-impact-stats__icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="filled">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </div>
            <div class="ai-impact-stats__counter-{{ ai_gen_id }}" data-target="{{ block.settings.stat_3_number }}">0</div>
            <div class="ai-impact-stats__label-{{ ai_gen_id }}">{{ block.settings.stat_3_label }}</div>
          </div>
        {% endif %}

        {% if block.settings.stat_4_enabled %}
          <div class="ai-impact-stats__item-{{ ai_gen_id }}">
            <div class="ai-impact-stats__icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5"></path>
                <path d="M11 19h8.203a1.83 1.83 0 0 0 1.556-.89 1.784 1.784 0 0 0 0-1.775l-1.226-2.12"></path>
                <path d="m14 16-3 3 3 3"></path>
                <path d="M8.293 13.596 7.196 9.5 3.1 10.598"></path>
                <path d="m9.344 5.811 1.093-1.892A1.83 1.83 0 0 1 11.985 3a1.784 1.784 0 0 1 1.546.888l3.943 6.843"></path>
                <path d="m13.378 9.633 4.096 1.098 1.097-4.096"></path>
              </svg>
            </div>
            <div class="ai-impact-stats__counter-{{ ai_gen_id }}" data-target="{{ block.settings.stat_4_number }}">0</div>
            <div class="ai-impact-stats__label-{{ ai_gen_id }}">{{ block.settings.stat_4_label }}</div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</impact-stats-{{ ai_gen_id }}>

<script>
  (function() {
    class ImpactStats{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.animated = false;
      }

      connectedCallback() {
        this.counters = this.querySelectorAll('.ai-impact-stats__counter-{{ ai_gen_id }}');
        this.setupIntersectionObserver();
      }

      setupIntersectionObserver() {
        const options = {
          threshold: 0.5,
          rootMargin: '0px'
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting && !this.animated) {
              this.animated = true;
              this.animateCounters();
            }
          });
        }, options);

        observer.observe(this);
      }

      animateCounters() {
        this.counters.forEach(counter => {
          const target = parseInt(counter.getAttribute('data-target'));
          const duration = 2000;
          const increment = target / (duration / 16);
          let current = 0;

          const updateCounter = () => {
            current += increment;
            if (current < target) {
              counter.textContent = Math.floor(current).toLocaleString();
              requestAnimationFrame(updateCounter);
            } else {
              counter.textContent = target.toLocaleString();
            }
          };

          updateCounter();
        });
      }
    }

    customElements.define('impact-stats-{{ ai_gen_id }}', ImpactStats{{ ai_gen_id }});
  })();
</script>

