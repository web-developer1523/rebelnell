{% doc %}
  @prompt
    create a promotional grid that has the option to stack or not on mobile. have a slider. I should be able to edit alignment, text, font, size, , i need the ability to hide the unused  items, show the button for each item in both desktop and mobile, instead of navigation arrows I would like a sliding bar that i can edit the color of and should work on both mobile and desktop, This section also needs a title , I only need two sections, the two item sections should be centered, add the ability to center align title text, sub text and buttons, add a sub title part to the top section, I want to be able to adjust the height of the items, the items images should have text protection the text should be editable in font, size, and color
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-grid-{{ ai_gen_id }} {
    width: 100%;
    display: block;
  }

  .ai-promo-grid__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    margin-bottom: 30px;
  }

  .ai-promo-grid__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px 0;
  }

  .ai-promo-grid__subtitle-{{ ai_gen_id }} {
    font-family: {{ block.settings.subtitle_font.family }}, {{ block.settings.subtitle_font.fallback_families }};
    font-weight: {{ block.settings.subtitle_font.weight }};
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-promo-grid__slider-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
  }

  .ai-promo-grid__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.4s ease;
    gap: 20px;
  }

  .ai-promo-grid__item-{{ ai_gen_id }} {
    flex: 0 0 calc(50% - 10px);
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    height: {{ block.settings.item_height }}px;
  }

  .ai-promo-grid__item-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-promo-grid__item-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-promo-grid__item-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-promo-grid__item-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, {{ block.settings.text_protection_opacity }}) 100%);
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    align-items: {{ block.settings.content_horizontal_alignment }};
    padding: 30px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-promo-grid__item-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.item_title_font.family }}, {{ block.settings.item_title_font.fallback_families }};
    font-weight: {{ block.settings.item_title_font.weight }};
    font-size: {{ block.settings.item_title_size }}px;
    color: {{ block.settings.item_title_color }};
    margin: 0 0 10px 0;
  }

  .ai-promo-grid__item-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.item_text_font.family }}, {{ block.settings.item_text_font.fallback_families }};
    font-weight: {{ block.settings.item_text_font.weight }};
    font-size: {{ block.settings.item_text_size }}px;
    color: {{ block.settings.item_text_color }};
    margin: 0 0 20px 0;
  }

  .ai-promo-grid__item-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: 4px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-size: {{ block.settings.button_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-promo-grid__item-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-promo-grid__progress-{{ ai_gen_id }} {
    margin-top: 20px;
    width: 100%;
    height: {{ block.settings.progress_bar_height }}px;
    background-color: {{ block.settings.progress_bar_bg_color }};
    border-radius: {{ block.settings.progress_bar_height | divided_by: 2 }}px;
    overflow: hidden;
  }

  .ai-promo-grid__progress-fill-{{ ai_gen_id }} {
    height: 100%;
    background-color: {{ block.settings.progress_bar_color }};
    transition: width 0.4s ease;
    border-radius: {{ block.settings.progress_bar_height | divided_by: 2 }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-promo-grid__item-{{ ai_gen_id }} {
      {% if block.settings.stack_on_mobile %}
        flex: 0 0 100%;
      {% else %}
        flex: 0 0 calc(50% - 10px);
      {% endif %}
    }

    .ai-promo-grid__item-overlay-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-promo-grid__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-promo-grid__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.8 }}px;
    }

    .ai-promo-grid__item-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.item_title_size | times: 0.8 }}px;
    }

    .ai-promo-grid__item-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.item_text_size | times: 0.8 }}px;
    }

    .ai-promo-grid__item-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_size | times: 0.8 }}px;
      padding: 10px 20px;
    }
  }
{% endstyle %}

<promo-grid-{{ ai_gen_id }} class="ai-promo-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.section_title != blank or block.settings.section_subtitle != blank %}
    <div class="ai-promo-grid__header-{{ ai_gen_id }}">
      {% if block.settings.section_title != blank %}
        <h2 class="ai-promo-grid__title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      {% endif %}
      {% if block.settings.section_subtitle != blank %}
        <p class="ai-promo-grid__subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-promo-grid__slider-{{ ai_gen_id }}">
    <div class="ai-promo-grid__track-{{ ai_gen_id }}" data-track>
      {% for i in (1..2) %}
        {% liquid
          assign enabled_key = 'item_' | append: i | append: '_enabled'
          assign image_key = 'item_' | append: i | append: '_image'
          assign title_key = 'item_' | append: i | append: '_title'
          assign text_key = 'item_' | append: i | append: '_text'
          assign button_text_key = 'item_' | append: i | append: '_button_text'
          assign button_link_key = 'item_' | append: i | append: '_button_link'

          assign enabled = block.settings[enabled_key]
          assign image = block.settings[image_key]
          assign title = block.settings[title_key]
          assign text = block.settings[text_key]
          assign button_text = block.settings[button_text_key]
          assign button_link = block.settings[button_link_key]
        %}

        {% if enabled %}
          <div class="ai-promo-grid__item-{{ ai_gen_id }}" data-item>
            {% if image %}
              <img
                src="{{ image | image_url: width: 1000 }}"
                alt="{{ image.alt | escape }}"
                class="ai-promo-grid__item-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% else %}
              <div class="ai-promo-grid__item-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            <div class="ai-promo-grid__item-overlay-{{ ai_gen_id }}">
              {% if title != blank %}
                <h3 class="ai-promo-grid__item-title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}
              {% if text != blank %}
                <p class="ai-promo-grid__item-text-{{ ai_gen_id }}">{{ text }}</p>
              {% endif %}
              {% if button_text != blank %}
                <a
                  href="{{ button_link | default: '#' }}"
                  class="ai-promo-grid__item-button-{{ ai_gen_id }}"
                >
                  {{ button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-promo-grid__progress-{{ ai_gen_id }}">
      <div class="ai-promo-grid__progress-fill-{{ ai_gen_id }}" data-progress></div>
    </div>
  </div>
</promo-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class PromoGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.isDragging = false;
        this.startPos = 0;
        this.currentTranslate = 0;
        this.prevTranslate = 0;
        this.animationID = 0;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.items = this.querySelectorAll('[data-item]');
        this.progress = this.querySelector('[data-progress]');
        this.totalItems = this.items.length;

        if (this.totalItems === 0) return;

        this.setupEventListeners();
        this.updateProgress();
      }

      setupEventListeners() {
        this.track.addEventListener('mousedown', this.touchStart.bind(this));
        this.track.addEventListener('touchstart', this.touchStart.bind(this));
        this.track.addEventListener('mouseup', this.touchEnd.bind(this));
        this.track.addEventListener('touchend', this.touchEnd.bind(this));
        this.track.addEventListener('mousemove', this.touchMove.bind(this));
        this.track.addEventListener('touchmove', this.touchMove.bind(this));
        this.track.addEventListener('mouseleave', this.touchEnd.bind(this));

        window.addEventListener('resize', this.handleResize.bind(this));
      }

      getPositionX(event) {
        return event.type.includes('mouse') ? event.pageX : event.touches[0].clientX;
      }

      touchStart(event) {
        this.isDragging = true;
        this.startPos = this.getPositionX(event);
        this.animationID = requestAnimationFrame(this.animation.bind(this));
        this.track.style.cursor = 'grabbing';
      }

      touchMove(event) {
        if (this.isDragging) {
          const currentPosition = this.getPositionX(event);
          this.currentTranslate = this.prevTranslate + currentPosition - this.startPos;
        }
      }

      touchEnd() {
        this.isDragging = false;
        cancelAnimationFrame(this.animationID);

        const movedBy = this.currentTranslate - this.prevTranslate;
        const itemWidth = this.items[0].offsetWidth + 20;

        if (movedBy < -50 && this.currentIndex < this.totalItems - this.getVisibleItems()) {
          this.currentIndex += 1;
        }

        if (movedBy > 50 && this.currentIndex > 0) {
          this.currentIndex -= 1;
        }

        this.setPositionByIndex();
        this.track.style.cursor = 'grab';
      }

      animation() {
        this.setSliderPosition();
        if (this.isDragging) requestAnimationFrame(this.animation.bind(this));
      }

      setSliderPosition() {
        this.track.style.transform = `translateX(${this.currentTranslate}px)`;
      }

      setPositionByIndex() {
        const itemWidth = this.items[0].offsetWidth + 20;
        this.currentTranslate = this.currentIndex * -itemWidth;
        this.prevTranslate = this.currentTranslate;
        this.setSliderPosition();
        this.updateProgress();
      }

      getVisibleItems() {
        const isMobile = window.innerWidth < 750;
        const stackOnMobile = {{ block.settings.stack_on_mobile | json }};
        return (isMobile && stackOnMobile) ? 1 : 2;
      }

      updateProgress() {
        const maxIndex = Math.max(0, this.totalItems - this.getVisibleItems());
        const progressPercent = maxIndex > 0 ? (this.currentIndex / maxIndex) * 100 : 100;
        this.progress.style.width = `${progressPercent}%`;
      }

      handleResize() {
        this.currentIndex = 0;
        this.currentTranslate = 0;
        this.prevTranslate = 0;
        this.setSliderPosition();
        this.updateProgress();
      }
    }

    customElements.define('promo-grid-{{ ai_gen_id }}', PromoGrid{{ ai_gen_id }});
  })();
</script>

