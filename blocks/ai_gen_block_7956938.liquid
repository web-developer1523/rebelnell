{% doc %}
  @prompt
    thin hero image with text and header with subtitle and four collections stacked to right of hero and scrolling in single line underneath header for mobile. Make sure you size the collection images to align with hero image, almost perfect add a small header above the collection images, align the collection images to match the size of the header
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-collections-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-hero-collections__desktop-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 20px;
    align-items: start;
  }

  .ai-hero-collections__mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-hero-collections__hero-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-hero-collections__hero-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.hero_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-hero-collections__hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-collections__hero-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-collections__hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-collections__hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: {{ block.settings.text_alignment }};
    padding: 40px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-hero-collections__hero-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 10px 0;
    font-weight: 700;
  }

  .ai-hero-collections__hero-subtitle-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subtitle_size }}px;
    margin: 0;
  }

  .ai-hero-collections__collections-sidebar-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-hero-collections__sidebar-header-{{ ai_gen_id }} {
    color: {{ block.settings.sidebar_header_color }};
    font-size: {{ block.settings.sidebar_header_size }}px;
    margin: 0 0 15px 0;
    font-weight: 600;
    text-align: {{ block.settings.sidebar_header_alignment }};
  }

  .ai-hero-collections__collections-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 0;
    height: {{ block.settings.hero_height }}px;
  }

  .ai-hero-collections__collection-item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    flex: 1;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    text-decoration: none;
    display: block;
  }

  .ai-hero-collections__collection-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-hero-collections__collection-item-{{ ai_gen_id }}:hover .ai-hero-collections__collection-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-hero-collections__collection-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-collections__collection-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-hero-collections__collection-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 15px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  }

  .ai-hero-collections__collection-title-{{ ai_gen_id }} {
    color: #ffffff;
    font-size: {{ block.settings.collection_title_size }}px;
    margin: 0;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-collections__desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-collections__mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero-collections__hero-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.hero_height_mobile }}px;
    }

    .ai-hero-collections__hero-overlay-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-hero-collections__hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-hero-collections__hero-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.8 }}px;
    }

    .ai-hero-collections__sidebar-header-{{ ai_gen_id }} {
      font-size: {{ block.settings.sidebar_header_size | times: 0.8 }}px;
      margin-bottom: 15px;
    }

    .ai-hero-collections__mobile-collections-{{ ai_gen_id }} {
      margin-top: 20px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .ai-hero-collections__mobile-collections-scroll-{{ ai_gen_id }} {
      display: flex;
      gap: 15px;
      padding-bottom: 10px;
    }

    .ai-hero-collections__collection-item-{{ ai_gen_id }} {
      flex-shrink: 0;
      width: 200px;
      height: {{ block.settings.collection_height_mobile }}px;
    }
  }
{% endstyle %}

<hero-collections-{{ ai_gen_id }} class="ai-hero-collections-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-collections__desktop-{{ ai_gen_id }}">
    <div class="ai-hero-collections__hero-section-{{ ai_gen_id }}">
      <div class="ai-hero-collections__hero-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.hero_image %}
          <img
            src="{{ block.settings.hero_image | image_url: width: 2000 }}"
            alt="{{ block.settings.hero_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.hero_image.width }}"
            height="{{ block.settings.hero_image.height }}"
            class="ai-hero-collections__hero-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-hero-collections__hero-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
        <div class="ai-hero-collections__hero-overlay-{{ ai_gen_id }}">
          {% if block.settings.heading != blank %}
            <h2 class="ai-hero-collections__hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.subtitle != blank %}
            <p class="ai-hero-collections__hero-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="ai-hero-collections__collections-sidebar-{{ ai_gen_id }}">
      {% if block.settings.sidebar_header != blank %}
        <h3 class="ai-hero-collections__sidebar-header-{{ ai_gen_id }}">{{ block.settings.sidebar_header }}</h3>
      {% endif %}
      <div class="ai-hero-collections__collections-wrapper-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign collection = block.settings[collection_key]
          %}
          <a
            href="{% if collection %}{{ collection.url }}{% else %}#{% endif %}"
            class="ai-hero-collections__collection-item-{{ ai_gen_id }}"
          >
            {% if collection and collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 600 }}"
                alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                loading="lazy"
                width="600"
                height="400"
                class="ai-hero-collections__collection-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-hero-collections__collection-placeholder-{{ ai_gen_id }}">
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
            <div class="ai-hero-collections__collection-overlay-{{ ai_gen_id }}">
              <h3 class="ai-hero-collections__collection-title-{{ ai_gen_id }}">
                {% if collection %}{{ collection.title }}{% else %}Collection {{ i }}{% endif %}
              </h3>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="ai-hero-collections__mobile-{{ ai_gen_id }}">
    <div class="ai-hero-collections__hero-section-{{ ai_gen_id }}">
      <div class="ai-hero-collections__hero-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.hero_image %}
          <img
            src="{{ block.settings.hero_image | image_url: width: 1000 }}"
            alt="{{ block.settings.hero_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.hero_image.width }}"
            height="{{ block.settings.hero_image.height }}"
            class="ai-hero-collections__hero-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-hero-collections__hero-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
        <div class="ai-hero-collections__hero-overlay-{{ ai_gen_id }}">
          {% if block.settings.heading != blank %}
            <h2 class="ai-hero-collections__hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.subtitle != blank %}
            <p class="ai-hero-collections__hero-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="ai-hero-collections__mobile-collections-{{ ai_gen_id }}">
      {% if block.settings.sidebar_header != blank %}
        <h3 class="ai-hero-collections__sidebar-header-{{ ai_gen_id }}">{{ block.settings.sidebar_header }}</h3>
      {% endif %}
      <div class="ai-hero-collections__mobile-collections-scroll-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign collection = block.settings[collection_key]
          %}
          <a
            href="{% if collection %}{{ collection.url }}{% else %}#{% endif %}"
            class="ai-hero-collections__collection-item-{{ ai_gen_id }}"
          >
            {% if collection and collection.featured_image %}
              <img
                src="{{ collection.featured_image | image_url: width: 400 }}"
                alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                loading="lazy"
                width="400"
                height="300"
                class="ai-hero-collections__collection-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-hero-collections__collection-placeholder-{{ ai_gen_id }}">
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
            <div class="ai-hero-collections__collection-overlay-{{ ai_gen_id }}">
              <h3 class="ai-hero-collections__collection-title-{{ ai_gen_id }}">
                {% if collection %}{{ collection.title }}{% else %}Collection {{ i }}{% endif %}
              </h3>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</hero-collections-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroCollections{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
        window.addEventListener('resize', this.init.bind(this));
      }

      init() {
        if (window.innerWidth > 749) {
          this.alignCollectionHeights();
        }
      }

      alignCollectionHeights() {
        const heroWrapper = this.querySelector('.ai-hero-collections__hero-image-wrapper-{{ ai_gen_id }}');
        const collectionsWrapper = this.querySelector('.ai-hero-collections__collections-wrapper-{{ ai_gen_id }}');
        
        if (heroWrapper && collectionsWrapper) {
          const heroHeight = heroWrapper.offsetHeight;
          collectionsWrapper.style.height = heroHeight + 'px';
        }
      }
    }

    customElements.define('hero-collections-{{ ai_gen_id }}', HeroCollections{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Hero with collections",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Desktop height",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "hero_height_mobile",
      "label": "Mobile height",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.3
    },
    {
      "type": "header",
      "content": "Hero text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover our latest collections"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Collections sidebar"
    },
    {
      "type": "text",
      "id": "sidebar_header",
      "label": "Sidebar header",
      "default": "Shop by category"
    },
    {
      "type": "color",
      "id": "sidebar_header_color",
      "label": "Header color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "sidebar_header_size",
      "label": "Header size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "sidebar_header_alignment",
      "label": "Header alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "Collection 4"
    },
    {
      "type": "range",
      "id": "collection_height_mobile",
      "label": "Mobile collection height",
      "min": 100,
      "max": 300,
      "step": 20,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "collection_title_size",
      "label": "Collection title size",
      "min": 12,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero with collections"
    }
  ]
}
{% endschema %}
