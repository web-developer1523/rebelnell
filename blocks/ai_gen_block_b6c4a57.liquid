{% doc %}
  @prompt
    I want a clickable carousel that highlights three pages. With a heading text that can be edited in alignment, size, color, boldness, and font, add a fourth page section, instead of page it should be a link, I need a sub heading under the heading text, I want a link instead of page selection
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-page-carousel-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-page-carousel__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-page-carousel__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 30px;
  }

  .ai-page-carousel__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {% if block.settings.heading_bold %}700{% else %}{{ block.settings.heading_font.weight }}{% endif %};
    margin: 0 0 10px;
  }

  .ai-page-carousel__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-page-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-page-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    transition: transform 0.4s ease;
  }

  .ai-page-carousel__item-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - 14px);
    min-width: 0;
  }

  .ai-page-carousel__card-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
  }

  .ai-page-carousel__card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  }

  .ai-page-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 75%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-page-carousel__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-page-carousel__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-page-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-page-carousel__content-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-page-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 10px;
    font-weight: 600;
  }

  .ai-page-carousel__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    color: {{ block.settings.card_description_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-page-carousel__nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
  }

  .ai-page-carousel__nav-button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.nav_button_color }};
    background-color: transparent;
    color: {{ block.settings.nav_button_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-page-carousel__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_hover_color }};
  }

  .ai-page-carousel__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-page-carousel__nav-button-{{ ai_gen_id }}:disabled:hover {
    background-color: transparent;
    color: {{ block.settings.nav_button_color }};
  }

  .ai-page-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .ai-page-carousel__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-page-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 989px) {
    .ai-page-carousel__item-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 10px);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-page-carousel__item-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-page-carousel__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-page-carousel__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }
  }
{% endstyle %}

<page-carousel-{{ ai_gen_id }}
  class="ai-page-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-page-carousel__container-{{ ai_gen_id }}">
    <div class="ai-page-carousel__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-page-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="ai-page-carousel__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="ai-page-carousel__wrapper-{{ ai_gen_id }}">
      <div class="ai-page-carousel__track-{{ ai_gen_id }}">
        {% if block.settings.link_1_url != blank %}
          <div class="ai-page-carousel__item-{{ ai_gen_id }}">
            <a href="{{ block.settings.link_1_url }}" class="ai-page-carousel__card-{{ ai_gen_id }}">
              <div class="ai-page-carousel__image-wrapper-{{ ai_gen_id }}">
                {% if block.settings.link_1_image %}
                  <img
                    src="{{ block.settings.link_1_image | image_url: width: 600 }}"
                    alt="{{ block.settings.link_1_image.alt | escape }}"
                    class="ai-page-carousel__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="450"
                  >
                {% else %}
                  <div class="ai-page-carousel__image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-page-carousel__content-{{ ai_gen_id }}">
                <h3 class="ai-page-carousel__title-{{ ai_gen_id }}">{{ block.settings.link_1_title }}</h3>
                {% if block.settings.link_1_description != blank %}
                  <p class="ai-page-carousel__description-{{ ai_gen_id }}">{{ block.settings.link_1_description }}</p>
                {% endif %}
              </div>
            </a>
          </div>
        {% endif %}

        {% if block.settings.link_2_url != blank %}
          <div class="ai-page-carousel__item-{{ ai_gen_id }}">
            <a href="{{ block.settings.link_2_url }}" class="ai-page-carousel__card-{{ ai_gen_id }}">
              <div class="ai-page-carousel__image-wrapper-{{ ai_gen_id }}">
                {% if block.settings.link_2_image %}
                  <img
                    src="{{ block.settings.link_2_image | image_url: width: 600 }}"
                    alt="{{ block.settings.link_2_image.alt | escape }}"
                    class="ai-page-carousel__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="450"
                  >
                {% else %}
                  <div class="ai-page-carousel__image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-page-carousel__content-{{ ai_gen_id }}">
                <h3 class="ai-page-carousel__title-{{ ai_gen_id }}">{{ block.settings.link_2_title }}</h3>
                {% if block.settings.link_2_description != blank %}
                  <p class="ai-page-carousel__description-{{ ai_gen_id }}">{{ block.settings.link_2_description }}</p>
                {% endif %}
              </div>
            </a>
          </div>
        {% endif %}

        {% if block.settings.link_3_url != blank %}
          <div class="ai-page-carousel__item-{{ ai_gen_id }}">
            <a href="{{ block.settings.link_3_url }}" class="ai-page-carousel__card-{{ ai_gen_id }}">
              <div class="ai-page-carousel__image-wrapper-{{ ai_gen_id }}">
                {% if block.settings.link_3_image %}
                  <img
                    src="{{ block.settings.link_3_image | image_url: width: 600 }}"
                    alt="{{ block.settings.link_3_image.alt | escape }}"
                    class="ai-page-carousel__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="450"
                  >
                {% else %}
                  <div class="ai-page-carousel__image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-page-carousel__content-{{ ai_gen_id }}">
                <h3 class="ai-page-carousel__title-{{ ai_gen_id }}">{{ block.settings.link_3_title }}</h3>
                {% if block.settings.link_3_description != blank %}
                  <p class="ai-page-carousel__description-{{ ai_gen_id }}">{{ block.settings.link_3_description }}</p>
                {% endif %}
              </div>
            </a>
          </div>
        {% endif %}

        {% if block.settings.link_4_url != blank %}
          <div class="ai-page-carousel__item-{{ ai_gen_id }}">
            <a href="{{ block.settings.link_4_url }}" class="ai-page-carousel__card-{{ ai_gen_id }}">
              <div class="ai-page-carousel__image-wrapper-{{ ai_gen_id }}">
                {% if block.settings.link_4_image %}
                  <img
                    src="{{ block.settings.link_4_image | image_url: width: 600 }}"
                    alt="{{ block.settings.link_4_image.alt | escape }}"
                    class="ai-page-carousel__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="450"
                  >
                {% else %}
                  <div class="ai-page-carousel__image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-page-carousel__content-{{ ai_gen_id }}">
                <h3 class="ai-page-carousel__title-{{ ai_gen_id }}">{{ block.settings.link_4_title }}</h3>
                {% if block.settings.link_4_description != blank %}
                  <p class="ai-page-carousel__description-{{ ai_gen_id }}">{{ block.settings.link_4_description }}</p>
                {% endif %}
              </div>
            </a>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-page-carousel__nav-{{ ai_gen_id }}">
      <button
        class="ai-page-carousel__nav-button-{{ ai_gen_id }} ai-page-carousel__prev-{{ ai_gen_id }}"
        aria-label="Previous slide"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="12 4 6 10 12 16"></polyline>
        </svg>
      </button>
      <button
        class="ai-page-carousel__nav-button-{{ ai_gen_id }} ai-page-carousel__next-{{ ai_gen_id }}"
        aria-label="Next slide"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="8 4 14 10 8 16"></polyline>
        </svg>
      </button>
    </div>

    <div class="ai-page-carousel__dots-{{ ai_gen_id }}"></div>
  </div>
</page-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class PageCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.itemsPerView = 3;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-page-carousel__track-{{ ai_gen_id }}');
        this.items = this.querySelectorAll('.ai-page-carousel__item-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-page-carousel__prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-page-carousel__next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-page-carousel__dots-{{ ai_gen_id }}');

        this.updateItemsPerView();
        this.createDots();
        this.updateCarousel();
        this.setupEventListeners();

        window.addEventListener('resize', () => {
          this.updateItemsPerView();
          this.createDots();
          this.updateCarousel();
        });
      }

      updateItemsPerView() {
        const width = window.innerWidth;
        if (width <= 749) {
          this.itemsPerView = 1;
        } else if (width <= 989) {
          this.itemsPerView = 2;
        } else {
          this.itemsPerView = 3;
        }
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        const totalSlides = Math.ceil(this.items.length / this.itemsPerView);

        for (let i = 0; i < totalSlides; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-page-carousel__dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          if (i === 0) {
            dot.classList.add('active');
          }
          dot.addEventListener('click', () => {
            this.currentIndex = i * this.itemsPerView;
            this.updateCarousel();
          });
          this.dotsContainer.appendChild(dot);
        }
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => {
          if (this.currentIndex > 0) {
            this.currentIndex -= this.itemsPerView;
            if (this.currentIndex < 0) {
              this.currentIndex = 0;
            }
            this.updateCarousel();
          }
        });

        this.nextButton.addEventListener('click', () => {
          if (this.currentIndex < this.items.length - this.itemsPerView) {
            this.currentIndex += this.itemsPerView;
            if (this.currentIndex > this.items.length - this.itemsPerView) {
              this.currentIndex = this.items.length - this.itemsPerView;
            }
            this.updateCarousel();
          }
        });
      }

      updateCarousel() {
        const itemWidth = this.items[0].offsetWidth;
        const gap = 20;
        const offset = -(this.currentIndex * (itemWidth + gap));
        this.track.style.transform = 'translateX(' + offset + 'px)';

        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= this.items.length - this.itemsPerView;

        const dots = this.dotsContainer.querySelectorAll('.ai-page-carousel__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === Math.floor(this.currentIndex / this.itemsPerView)) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('page-carousel-{{ ai_gen_id }}', PageCarousel{{ ai_gen_id }});
  })();
</script>

