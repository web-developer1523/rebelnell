{% doc %}
  @prompt
    one large image with header and then a block of 4 products that scroll horizontally but produt image fits in the photo area to the right of the large image, include add to cart with the products, place header at top, the hero image isn't swipeabel just the products underneath the hero, just the product is swipeable. leave the hero image as separate and non scrollable
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-products-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-featured-products-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-featured-products-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
    text-align: {{ block.settings.header_alignment }};
  }

  .ai-featured-products-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.header_size }}px;
    color: {{ block.settings.header_color }};
    margin: 0;
  }

  .ai-featured-products-image-section-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin-bottom: {{ block.settings.gap }}px;
  }

  .ai-featured-products-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 400px;
  }

  .ai-featured-products-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-featured-products-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-featured-products-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-featured-products-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-featured-products-scroll-section-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-featured-products-scroll-container-{{ ai_gen_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.scrollbar_color }} transparent;
  }

  .ai-featured-products-scroll-container-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 8px;
  }

  .ai-featured-products-scroll-container-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: transparent;
  }

  .ai-featured-products-scroll-container-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background-color: {{ block.settings.scrollbar_color }};
    border-radius: 4px;
  }

  .ai-featured-products-grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_gap }}px;
  }

  .ai-featured-products-item-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.product_width }}px;
    background-color: {{ block.settings.product_bg_color }};
    border-radius: {{ block.settings.product_border_radius }}px;
    padding: {{ block.settings.product_padding }}px;
    display: flex;
    flex-direction: column;
  }

  .ai-featured-products-item-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    margin-bottom: 12px;
    overflow: hidden;
    border-radius: {{ block.settings.product_image_border_radius }}px;
  }

  .ai-featured-products-item-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-featured-products-item-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-products-item-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-featured-products-item-info-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-featured-products-item-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .ai-featured-products-item-title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-featured-products-item-title-link-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  .ai-featured-products-item-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    margin-bottom: 12px;
  }

  .ai-featured-products-item-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    margin-top: auto;
  }

  .ai-featured-products-item-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-featured-products-empty-products-{{ ai_gen_id }} {
    padding: 40px 20px;
    text-align: center;
    color: #999;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-products-image-wrapper-{{ ai_gen_id }} {
      min-height: 300px;
    }
  }
{% endstyle %}

<featured-products-{{ ai_gen_id }}
  class="ai-featured-products-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-featured-products-container-{{ ai_gen_id }}">
    {% if block.settings.header != blank %}
      <div class="ai-featured-products-header-{{ ai_gen_id }}">
        <h2 class="ai-featured-products-title-{{ ai_gen_id }}">{{ block.settings.header }}</h2>
      </div>
    {% endif %}

    <div class="ai-featured-products-image-section-{{ ai_gen_id }}">
      <div class="ai-featured-products-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.featured_image %}
          <img
            src="{{ block.settings.featured_image | image_url: width: 2000 }}"
            alt="{{ block.settings.featured_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.featured_image.width }}"
            height="{{ block.settings.featured_image.height }}"
            class="ai-featured-products-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-featured-products-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-featured-products-empty-state-{{ ai_gen_id }}">
              Add a featured image
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-featured-products-scroll-section-{{ ai_gen_id }}">
      <div class="ai-featured-products-scroll-container-{{ ai_gen_id }}">
        {% if block.settings.products != blank and block.settings.products.size > 0 %}
          <div class="ai-featured-products-grid-{{ ai_gen_id }}">
            {% for product in block.settings.products limit: 4 %}
              <div class="ai-featured-products-item-{{ ai_gen_id }}">
                <div class="ai-featured-products-item-image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 400 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      loading="lazy"
                      width="400"
                      height="400"
                      class="ai-featured-products-item-image-{{ ai_gen_id }}"
                    >
                  {% else %}
                    <div class="ai-featured-products-item-image-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>

                <div class="ai-featured-products-item-info-{{ ai_gen_id }}">
                  <h3 class="ai-featured-products-item-title-{{ ai_gen_id }}">
                    <a
                      href="{{ product.url }}"
                      class="ai-featured-products-item-title-link-{{ ai_gen_id }}"
                    >
                      {{ product.title }}
                    </a>
                  </h3>

                  <div class="ai-featured-products-item-price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </div>

                  <button
                    type="button"
                    class="ai-featured-products-item-button-{{ ai_gen_id }}"
                    data-product-id="{{ product.id }}"
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  >
                    {{ block.settings.button_text }}
                  </button>
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="ai-featured-products-empty-products-{{ ai_gen_id }}">
            Select up to 4 products to display
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</featured-products-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-featured-products-item-button-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', (event) => {
            const variantId = event.target.dataset.variantId;
            this.addToCart(variantId, button);
          });
        });
      }

      addToCart(variantId, button) {
        const originalText = button.textContent;
        button.textContent = 'Adding...';
        button.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          })
        })
        .then(response => response.json())
        .then(data => {
          button.textContent = 'Added!';
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);

          if (window.theme && window.theme.cart) {
            window.theme.cart.getCart();
          }

          document.dispatchEvent(new CustomEvent('cart:updated'));
        })
        .catch(error => {
          console.error('Error adding to cart:', error);
          button.textContent = 'Error';
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);
        });
      }
    }

    customElements.define('featured-products-{{ ai_gen_id }}', FeaturedProducts{{ ai_gen_id }});
  })();
</script>

