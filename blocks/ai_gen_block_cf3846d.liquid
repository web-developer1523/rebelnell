{% doc %}
  @prompt
    a featured collection with one large image and several small images around it to help tell the story of the collection better. make the collection images include  add to cart and a button on the featured image of the section that say shop all, can you remove some of the white space in the top and have the products scrolling below the main image, this is perfect just remove the side images. Put the text over the image, add the products for the collection below the featured collection that are scrollable and include add to cart, i want to be able to edit the alignment of all the text, I want to be able to put the text in the hero image to the bottom center of the image in both mobile and desktop. the product text should be center aligned, Make the product images clickable links that navigate to each product's detail page when clicked., Keep all existing functionality.
    Please add:
    1. When clicking "Add to Cart", open a Quick Add modal instead of adding directly.
    The modal should include:
    - Product image
    - Product title
    - Price
    - Variant selector
    - Quantity selector
    - Add to Cart button
    
    The image and price should update automatically when a different variant is selected.
    Only show available variants.
    
    2. Add Theme Editor settings to move the product title up and down separately for Desktop and Mobile.
    
    Add Theme Editor settings for the Hero Title:
    - Vertical position (Desktop)
    - Vertical position (Mobile)
    - Maximum width (Desktop)
    - Maximum width (Mobile)
    
    The title should use the full available width before wrapping. Do not use a fixed-width title container.
    
    Do not remove or change any existing features. Only extend the current section., Make the Quick Add modal more compact like Shopify's default Quick View. Reduce the image size, padding, and overall modal dimensions.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-featured-collection__hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.hero_height_desktop }}px;
    overflow: hidden;
  }

  .ai-featured-collection__hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-featured-collection__hero-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ block.settings.hero_height_desktop }}px;
  }

  .ai-featured-collection__hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-featured-collection__hero-content-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.hero_title_position_desktop }}%;
    {% if block.settings.text_position_horizontal == 'left' %}
      left: {{ block.settings.text_offset_horizontal }}px;
      text-align: left;
    {% elsif block.settings.text_position_horizontal == 'center' %}
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
    {% else %}
      right: {{ block.settings.text_offset_horizontal }}px;
      text-align: right;
    {% endif %}
    max-width: {{ block.settings.hero_title_max_width_desktop }}%;
    z-index: 2;
  }

  .ai-featured-collection__hero-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px;
    font-weight: 700;
  }

  .ai-featured-collection__hero-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.text_spacing }}px;
    line-height: 1.5;
  }

  .ai-featured-collection__shop-all-btn-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-featured-collection__shop-all-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-featured-collection__products-{{ ai_gen_id }} {
    padding: {{ block.settings.products_section_padding }}px 20px;
    background-color: {{ block.settings.products_bg_color }};
  }

  .ai-featured-collection__products-scroll-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_gap }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.scrollbar_color }} transparent;
  }

  .ai-featured-collection__products-scroll-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 8px;
  }

  .ai-featured-collection__products-scroll-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: transparent;
  }

  .ai-featured-collection__products-scroll-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background-color: {{ block.settings.scrollbar_color }};
    border-radius: 4px;
  }

  .ai-featured-collection__product-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.product_card_width }}px;
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .ai-featured-collection__product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    margin-bottom: {{ block.settings.product_title_spacing_desktop }}px;
    overflow: hidden;
    border-radius: {{ block.settings.product_image_border_radius }}px;
  }

  .ai-featured-collection__product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .ai-featured-collection__product-image-wrapper-{{ ai_gen_id }}:hover .ai-featured-collection__product-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-featured-collection__product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-collection__product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-featured-collection__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_text_color }};
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-featured-collection__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_text_color }};
    margin: 0 0 12px;
  }

  .ai-featured-collection__add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 20px;
    background-color: {{ block.settings.add_to_cart_bg_color }};
    color: {{ block.settings.add_to_cart_text_color }};
    border: none;
    border-radius: {{ block.settings.add_to_cart_border_radius }}px;
    font-size: {{ block.settings.add_to_cart_text_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-featured-collection__add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.add_to_cart_hover_bg_color }};
    color: {{ block.settings.add_to_cart_hover_text_color }};
  }

  .ai-featured-collection__add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-featured-collection__product-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .ai-featured-collection__modal-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-featured-collection__modal-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-featured-collection__modal-{{ ai_gen_id }} {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.95);
    background-color: {{ block.settings.modal_bg_color }};
    border-radius: 8px;
    max-width: 420px;
    width: 90%;
    max-height: 85vh;
    overflow-y: auto;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .ai-featured-collection__modal-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  .ai-featured-collection__modal-content-{{ ai_gen_id }} {
    padding: 20px;
    position: relative;
  }

  .ai-featured-collection__modal-close-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: {{ block.settings.modal_text_color }};
    line-height: 1;
    padding: 5px;
    opacity: 0.6;
    transition: opacity 0.2s ease;
    z-index: 1;
  }

  .ai-featured-collection__modal-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-featured-collection__modal-image-{{ ai_gen_id }} {
    width: 100%;
    max-height: 100%;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 16px;
  }

  .ai-featured-collection__modal-title-{{ ai_gen_id }} {
    font-size: 18px;
    color: {{ block.settings.modal_text_color }};
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-featured-collection__modal-price-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.modal_text_color }};
    margin: 0 0 16px;
    font-weight: 500;
  }

  .ai-featured-collection__modal-variants-{{ ai_gen_id }} {
    margin-bottom: 12px;
  }

  .ai-featured-collection__modal-label-{{ ai_gen_id }} {
    display: block;
    font-size: 13px;
    color: {{ block.settings.modal_text_color }};
    margin-bottom: 6px;
    font-weight: 500;
  }

  .ai-featured-collection__modal-select-{{ ai_gen_id }} {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid {{ block.settings.modal_border_color }};
    border-radius: 4px;
    font-size: 14px;
    background-color: {{ block.settings.modal_input_bg_color }};
    color: {{ block.settings.modal_text_color }};
    cursor: pointer;
  }

  .ai-featured-collection__modal-quantity-{{ ai_gen_id }} {
    margin-bottom: 16px;
  }

  .ai-featured-collection__modal-quantity-input-{{ ai_gen_id }} {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid {{ block.settings.modal_border_color }};
    border-radius: 4px;
    font-size: 14px;
    background-color: {{ block.settings.modal_input_bg_color }};
    color: {{ block.settings.modal_text_color }};
  }

  .ai-featured-collection__modal-add-btn-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px;
    background-color: {{ block.settings.modal_button_bg_color }};
    color: {{ block.settings.modal_button_text_color }};
    border: none;
    border-radius: {{ block.settings.modal_button_border_radius }}px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .ai-featured-collection__modal-add-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.modal_button_hover_bg_color }};
    color: {{ block.settings.modal_button_hover_text_color }};
  }

  .ai-featured-collection__modal-add-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection__hero-{{ ai_gen_id }} {
      min-height: {{ block.settings.hero_height_mobile }}px;
    }

    .ai-featured-collection__hero-placeholder-{{ ai_gen_id }} {
      min-height: {{ block.settings.hero_height_mobile }}px;
    }

    .ai-featured-collection__hero-content-{{ ai_gen_id }} {
      top: {{ block.settings.hero_title_position_mobile }}%;
      max-width: {{ block.settings.hero_title_max_width_mobile }}%;
    }

    .ai-featured-collection__hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-featured-collection__hero-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.8 }}px;
    }

    .ai-featured-collection__product-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.product_card_width_mobile }}px;
    }

    .ai-featured-collection__product-image-wrapper-{{ ai_gen_id }} {
      margin-bottom: {{ block.settings.product_title_spacing_mobile }}px;
    }

    .ai-featured-collection__modal-{{ ai_gen_id }} {
      max-width: 360px;
    }

    .ai-featured-collection__modal-content-{{ ai_gen_id }} {
      padding: 16px;
    }

    .ai-featured-collection__modal-image-{{ ai_gen_id }} {
      max-height: 240px;
    }
  }
{% endstyle %}

<featured-collection-{{ ai_gen_id }} class="ai-featured-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-collection__hero-{{ ai_gen_id }}">
    {% if block.settings.hero_image %}
      <img
        src="{{ block.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ block.settings.hero_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.hero_image.width }}"
        height="{{ block.settings.hero_image.height }}"
        class="ai-featured-collection__hero-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-featured-collection__hero-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    <div class="ai-featured-collection__hero-content-{{ ai_gen_id }}">
      {% if block.settings.hero_title != blank %}
        <h2 class="ai-featured-collection__hero-title-{{ ai_gen_id }}">{{ block.settings.hero_title }}</h2>
      {% endif %}

      {% if block.settings.hero_description != blank %}
        <div class="ai-featured-collection__hero-description-{{ ai_gen_id }}">
          {{ block.settings.hero_description }}
        </div>
      {% endif %}

      {% if block.settings.collection != blank %}
        <a
          href="{{ block.settings.collection.url }}"
          class="ai-featured-collection__shop-all-btn-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>

  {% if block.settings.collection != blank %}
    <div class="ai-featured-collection__products-{{ ai_gen_id }}">
      <div class="ai-featured-collection__products-scroll-{{ ai_gen_id }}">
        {% for product in block.settings.collection.products limit: block.settings.products_limit %}
          <div class="ai-featured-collection__product-card-{{ ai_gen_id }}" data-product-handle="{{ product.handle }}">
            <a href="{{ product.url }}" class="ai-featured-collection__product-link-{{ ai_gen_id }}">
              <div class="ai-featured-collection__product-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="600"
                    class="ai-featured-collection__product-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-featured-collection__product-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <h3 class="ai-featured-collection__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>

              <div class="ai-featured-collection__product-price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>
            </a>

            <button
              class="ai-featured-collection__add-to-cart-{{ ai_gen_id }}"
              data-product-handle="{{ product.handle }}"
              {% unless product.available %}disabled{% endunless %}
            >
              {% if product.available %}
                {{ block.settings.add_to_cart_text }}
              {% else %}
                Sold out
              {% endif %}
            </button>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="ai-featured-collection__modal-overlay-{{ ai_gen_id }}"></div>
  <div class="ai-featured-collection__modal-{{ ai_gen_id }}">
    <div class="ai-featured-collection__modal-content-{{ ai_gen_id }}">
      <button class="ai-featured-collection__modal-close-{{ ai_gen_id }}" aria-label="Close">&times;</button>
      <img class="ai-featured-collection__modal-image-{{ ai_gen_id }}" src="" alt="">
      <h3 class="ai-featured-collection__modal-title-{{ ai_gen_id }}"></h3>
      <div class="ai-featured-collection__modal-price-{{ ai_gen_id }}"></div>
      
      <div class="ai-featured-collection__modal-variants-{{ ai_gen_id }}" style="display: none;">
        <label class="ai-featured-collection__modal-label-{{ ai_gen_id }}">Variant</label>
        <select class="ai-featured-collection__modal-select-{{ ai_gen_id }}"></select>
      </div>

      <div class="ai-featured-collection__modal-quantity-{{ ai_gen_id }}" style="display:none;">
        <label class="ai-featured-collection__modal-label-{{ ai_gen_id }}">Quantity</label>
        <input type="number" class="ai-featured-collection__modal-quantity-input-{{ ai_gen_id }}" value="1" min="1">
      </div>

      <button class="ai-featured-collection__modal-add-btn-{{ ai_gen_id }}">
        {{ block.settings.add_to_cart_text }}
      </button>
    </div>
  </div>
</featured-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentProduct = null;
      }

      connectedCallback() {
        this.addToCartButtons = this.querySelectorAll('.ai-featured-collection__add-to-cart-{{ ai_gen_id }}');
        this.modal = this.querySelector('.ai-featured-collection__modal-{{ ai_gen_id }}');
        this.modalOverlay = this.querySelector('.ai-featured-collection__modal-overlay-{{ ai_gen_id }}');
        this.modalClose = this.querySelector('.ai-featured-collection__modal-close-{{ ai_gen_id }}');
        this.modalImage = this.querySelector('.ai-featured-collection__modal-image-{{ ai_gen_id }}');
        this.modalTitle = this.querySelector('.ai-featured-collection__modal-title-{{ ai_gen_id }}');
        this.modalPrice = this.querySelector('.ai-featured-collection__modal-price-{{ ai_gen_id }}');
        this.modalVariants = this.querySelector('.ai-featured-collection__modal-variants-{{ ai_gen_id }}');
        this.modalVariantSelect = this.querySelector('.ai-featured-collection__modal-select-{{ ai_gen_id }}');
        this.modalQuantity = this.querySelector('.ai-featured-collection__modal-quantity-input-{{ ai_gen_id }}');
        this.modalAddBtn = this.querySelector('.ai-featured-collection__modal-add-btn-{{ ai_gen_id }}');
        
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.addToCartButtons.forEach((button) => {
          button.addEventListener('click', this.handleQuickAdd.bind(this));
        });

        this.modalClose.addEventListener('click', this.closeModal.bind(this));
        this.modalOverlay.addEventListener('click', this.closeModal.bind(this));
        this.modalVariantSelect.addEventListener('change', this.handleVariantChange.bind(this));
        this.modalAddBtn.addEventListener('click', this.handleModalAddToCart.bind(this));
      }

      async handleQuickAdd(event) {
        event.preventDefault();
        const button = event.target;
        const productHandle = button.dataset.productHandle;

        if (!productHandle) return;

        try {
          const response = await fetch('/products/' + productHandle + '.js');
          const product = await response.json();
          this.currentProduct = product;
          this.openModal(product);
        } catch (error) {
          console.error('Error fetching product:', error);
        }
      }

      openModal(product) {
        this.modalTitle.textContent = product.title;
        
        const availableVariants = product.variants.filter(function(variant) {
          return variant.available;
        });

        if (availableVariants.length > 0) {
          const firstVariant = availableVariants[0];
          
          if (firstVariant.featured_image && firstVariant.featured_image.src) {
            this.modalImage.src = firstVariant.featured_image.src;
          } else if (product.featured_image) {
            this.modalImage.src = product.featured_image;
          }
          
          this.modalImage.alt = product.title;
          this.modalPrice.textContent = this.formatMoney(firstVariant.price);

          if (availableVariants.length > 1) {
            this.modalVariants.style.display = 'block';
            this.modalVariantSelect.innerHTML = '';
            
            availableVariants.forEach((variant) => {
              const option = document.createElement('option');
              option.value = variant.id;
              option.textContent = variant.title;
              option.dataset.price = variant.price;
              option.dataset.image = variant.featured_image ? variant.featured_image.src : '';
              this.modalVariantSelect.appendChild(option);
            });
          } else {
            this.modalVariants.style.display = 'none';
          }

          this.modalQuantity.value = 1;
          this.modal.classList.add('active');
          this.modalOverlay.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      }

      closeModal() {
        this.modal.classList.remove('active');
        this.modalOverlay.classList.remove('active');
        document.body.style.overflow = '';
        this.currentProduct = null;
      }

      handleVariantChange(event) {
        const selectedOption = event.target.options[event.target.selectedIndex];
        const price = selectedOption.dataset.price;
        const image = selectedOption.dataset.image;

        this.modalPrice.textContent = this.formatMoney(price);

        if (image) {
          this.modalImage.src = image;
        } else if (this.currentProduct && this.currentProduct.featured_image) {
          this.modalImage.src = this.currentProduct.featured_image;
        }
      }

      async handleModalAddToCart() {
        const availableVariants = this.currentProduct.variants.filter(function(variant) {
          return variant.available;
        });

        let variantId;
        if (availableVariants.length > 1) {
          variantId = this.modalVariantSelect.value;
        } else if (availableVariants.length === 1) {
          variantId = availableVariants[0].id;
        } else {
          return;
        }

        const quantity = parseInt(this.modalQuantity.value);
        const originalText = this.modalAddBtn.textContent;

        this.modalAddBtn.disabled = true;
        this.modalAddBtn.textContent = 'Adding...';

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: quantity,
            }),
          });

          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }

          this.modalAddBtn.textContent = 'Added!';

          const cartResponse = await fetch('/cart.js');
          const cart = await cartResponse.json();

          document.documentElement.dispatchEvent(
            new CustomEvent('cart:refresh', {
              bubbles: true,
              detail: { cart },
            })
          );

          setTimeout(() => {
            this.closeModal();
            this.modalAddBtn.disabled = false;
            this.modalAddBtn.textContent = originalText;
          }, 1000);
        } catch (error) {
          console.error('Error adding to cart:', error);
          this.modalAddBtn.textContent = 'Error';
          setTimeout(() => {
            this.modalAddBtn.disabled = false;
            this.modalAddBtn.textContent = originalText;
          }, 2000);
        }
      }

      formatMoney(cents) {
        const dollars = (cents / 100).toFixed(2);
        return '$' + dollars;
      }
    }

    customElements.define('featured-collection-{{ ai_gen_id }}', FeaturedCollection{{ ai_gen_id }});
  })();
</script>

