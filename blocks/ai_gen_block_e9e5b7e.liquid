{% doc %}
  @prompt
    one image with header and then a block of 4 products that scroll underneath header for mobile but on desktop they are stacked two by two to the side of the header image, include add to cart with the products, place header at the top of the hero image, on desktop align the block of 4 products with the hero. On mobile the block should scroll in a single row, make the products smaller so that all four align with hero image, perfect for desktop, now make them standard size on mobile they are currently too large
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-products-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-hero-products-container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ai-hero-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-hero-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: auto;
  }

  .ai-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-hero-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-header-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.header_position_y }}%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    text-align: center;
    width: 90%;
    max-width: 600px;
  }

  .ai-hero-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-products-section-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.products_bg_color }};
    padding: {{ block.settings.products_padding }}px;
  }

  .ai-products-grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.products_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .ai-product-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    scroll-snap-align: start;
    min-width: 180px;
    max-width: 180px;
    flex-shrink: 0;
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-product-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-grow: 1;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 600;
  }

  .ai-product-add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 8px 12px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-product-add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-product-add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-product-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #999;
    font-style: italic;
  }

  @media screen and (min-width: 750px) {
    .ai-hero-products-container-{{ ai_gen_id }} {
      flex-direction: row;
      align-items: stretch;
    }

    .ai-hero-section-{{ ai_gen_id }} {
      flex: 1;
      min-width: 0;
    }

    .ai-products-section-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 40%;
      display: flex;
      align-items: stretch;
      padding: 0;
    }

    .ai-products-grid-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(2, 1fr);
      overflow-x: visible;
      scroll-snap-type: none;
      width: 100%;
      height: 100%;
      gap: {{ block.settings.products_gap }}px;
      padding: {{ block.settings.products_padding }}px;
    }

    .ai-product-card-{{ ai_gen_id }} {
      min-width: auto;
      max-width: none;
      flex-shrink: 1;
      gap: 6px;
    }

    .ai-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 1.2 }}px;
    }
  }
{% endstyle %}

<hero-products-{{ ai_gen_id }} class="ai-hero-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-products-container-{{ ai_gen_id }}">
    <div class="ai-hero-section-{{ ai_gen_id }}">
      <div class="ai-hero-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.hero_image %}
          <img
            src="{{ block.settings.hero_image | image_url: width: 1500 }}"
            alt="{{ block.settings.hero_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.hero_image.width }}"
            height="{{ block.settings.hero_image.height }}"
            class="ai-hero-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-hero-image-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-hero-empty-state-{{ ai_gen_id }}">
              Next, add a hero image
            </div>
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <div class="ai-hero-header-{{ ai_gen_id }}">
            <h2 class="ai-hero-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-products-section-{{ ai_gen_id }}">
      <div class="ai-products-grid-{{ ai_gen_id }}">
        {% liquid
          assign has_products = false
          for i in (1..4)
            assign product_key = 'product_' | append: i
            assign product = block.settings[product_key]
            if product != blank
              assign has_products = true
              break
            endif
          endfor
        %}

        {% if has_products %}
          {% for i in (1..4) %}
            {% liquid
              assign product_key = 'product_' | append: i
              assign product = block.settings[product_key]
            %}

            {% if product != blank %}
              <div class="ai-product-card-{{ ai_gen_id }}">
                <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 500 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      loading="lazy"
                      width="500"
                      height="500"
                      class="ai-product-image-{{ ai_gen_id }}"
                    >
                  {% else %}
                    <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                      {{ 'product-apparel-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>

                <div class="ai-product-info-{{ ai_gen_id }}">
                  <h3 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                  <div class="ai-product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
                </div>

                <button
                  class="ai-product-add-to-cart-{{ ai_gen_id }}"
                  data-product-id="{{ product.id }}"
                  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  {% unless product.available %}disabled{% endunless %}
                >
                  {% if product.available %}
                    {{ block.settings.button_text }}
                  {% else %}
                    Sold out
                  {% endif %}
                </button>
              </div>
            {% endif %}
          {% endfor %}
        {% else %}
          <div class="ai-product-empty-{{ ai_gen_id }}" style="grid-column: 1 / -1;">
            Next, add up to 4 products to display
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</hero-products-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.addToCartButtons = this.querySelectorAll('.ai-product-add-to-cart-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.addToCartButtons.forEach((button) => {
          button.addEventListener('click', this.handleAddToCart.bind(this));
        });
      }

      async handleAddToCart(event) {
        const button = event.target;
        const variantId = button.dataset.variantId;
        const originalText = button.textContent;

        if (!variantId || button.disabled) return;

        button.disabled = true;
        button.textContent = 'Adding...';

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: 1,
            }),
          });

          if (response.ok) {
            button.textContent = 'Added!';
            
            const cartCountElements = document.querySelectorAll('[data-cart-count]');
            const cartResponse = await fetch('/cart.js');
            const cart = await cartResponse.json();
            
            cartCountElements.forEach((element) => {
              element.textContent = cart.item_count;
            });

            setTimeout(() => {
              button.textContent = originalText;
              button.disabled = false;
            }, 2000);
          } else {
            throw new Error('Failed to add to cart');
          }
        } catch (error) {
          button.textContent = 'Error';
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);
        }
      }
    }

    customElements.define('hero-products-{{ ai_gen_id }}', HeroProducts{{ ai_gen_id }});
  })();
</script>

