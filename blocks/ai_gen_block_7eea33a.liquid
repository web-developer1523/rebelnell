      "default": "Column heading"
    },
    {
      "type": "richtext",
      "id": "text_2",
      "label": "Text",
      "default": "<p>Add descriptive text for this column.</p>"
    },
    {
      "type": "header",
      "content": "Column 3"
    },
    {
      "type": "image_picker",
