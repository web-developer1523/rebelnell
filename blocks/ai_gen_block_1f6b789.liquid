{% doc %}
  @prompt
    a scrolling wall of fame carousel of small images, text and review, Add headline of Wall of Fame. Include ability to add and delete reviews for future use, include ability to add and delete reviews, make it scrollable in addition to scrolling
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-wall-of-fame-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-wall-of-fame-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-wall-of-fame-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-wall-of-fame-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 600;
  }

  .ai-wall-of-fame-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow-x: auto;
    overflow-y: hidden;
    cursor: grab;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.heading_color }}33 transparent;
  }

  .ai-wall-of-fame-carousel-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 8px;
  }

  .ai-wall-of-fame-carousel-wrapper-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: transparent;
  }

  .ai-wall-of-fame-carousel-wrapper-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background-color: {{ block.settings.heading_color }}33;
    border-radius: 4px;
  }

  .ai-wall-of-fame-carousel-wrapper-{{ ai_gen_id }}:active {
    cursor: grabbing;
  }

  .ai-wall-of-fame-carousel-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    animation: ai-wall-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    will-change: transform;
    padding-bottom: 10px;
  }

  .ai-wall-of-fame-carousel-{{ ai_gen_id }}.is-dragging {
    animation-play-state: paused;
  }

  .ai-wall-of-fame-carousel-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  .ai-wall-of-fame-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 16px;
    user-select: none;
  }

  .ai-wall-of-fame-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    background-color: #f4f4f4;
    pointer-events: none;
  }

  .ai-wall-of-fame-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-wall-of-fame-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-wall-of-fame-image-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-wall-of-fame-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-grow: 1;
  }

  .ai-wall-of-fame-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    color: {{ block.settings.star_color }};
  }

  .ai-wall-of-fame-star-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
  }

  .ai-wall-of-fame-review-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-wall-of-fame-author-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_text_size }}px;
    color: {{ block.settings.author_color }};
    font-weight: 600;
    margin: 0;
  }

  .ai-wall-of-fame-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-wall-of-fame-empty-state-{{ ai_gen_id }} p {
    font-size: 16px;
    margin: 0;
  }

  @keyframes ai-wall-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-{{ block.settings.card_width }}px - {{ block.settings.card_gap }}px));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-wall-of-fame-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-wall-of-fame-container-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-wall-of-fame-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-wall-of-fame-card-{{ ai_gen_id }} {
      flex: 0 0 280px;
      padding: 20px;
    }

    .ai-wall-of-fame-image-wrapper-{{ ai_gen_id }} {
      height: 180px;
    }
  }
{% endstyle %}

<wall-of-fame-{{ ai_gen_id }} class="ai-wall-of-fame-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-wall-of-fame-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-wall-of-fame-header-{{ ai_gen_id }}">
        <h2 class="ai-wall-of-fame-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    {% assign has_reviews = false %}
    {% for i in (1..15) %}
      {% liquid
        assign review_enabled_key = 'review_' | append: i | append: '_enabled'
        assign review_enabled = block.settings[review_enabled_key]
        if review_enabled
          assign has_reviews = true
          break
        endif
      %}
    {% endfor %}

    {% if has_reviews %}
      <div class="ai-wall-of-fame-carousel-wrapper-{{ ai_gen_id }}" data-wrapper>
        <div class="ai-wall-of-fame-carousel-{{ ai_gen_id }}" data-carousel>
          {% for i in (1..15) %}
            {% liquid
              assign review_enabled_key = 'review_' | append: i | append: '_enabled'
              assign review_image_key = 'review_' | append: i | append: '_image'
              assign review_text_key = 'review_' | append: i | append: '_text'
              assign review_author_key = 'review_' | append: i | append: '_author'
              assign review_rating_key = 'review_' | append: i | append: '_rating'

              assign review_enabled = block.settings[review_enabled_key]
              assign review_image = block.settings[review_image_key]
              assign review_text = block.settings[review_text_key]
              assign review_author = block.settings[review_author_key]
              assign review_rating = block.settings[review_rating_key]
            %}

            {% if review_enabled %}
              <div class="ai-wall-of-fame-card-{{ ai_gen_id }}">
                <div class="ai-wall-of-fame-image-wrapper-{{ ai_gen_id }}">
                  {% if review_image %}
                    <img
                      src="{{ review_image | image_url: width: 600 }}"
                      alt="{{ review_author | escape }}"
                      class="ai-wall-of-fame-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="600"
                      height="{{ block.settings.image_height }}"
                    >
                  {% else %}
                    <div class="ai-wall-of-fame-image-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>

                <div class="ai-wall-of-fame-content-{{ ai_gen_id }}">
                  <div class="ai-wall-of-fame-stars-{{ ai_gen_id }}">
                    {% for star in (1..5) %}
                      {% if star <= review_rating %}
                        <svg class="ai-wall-of-fame-star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                      {% else %}
                        <svg class="ai-wall-of-fame-star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                      {% endif %}
                    {% endfor %}
                  </div>

                  {% if review_text != blank %}
                    <p class="ai-wall-of-fame-review-{{ ai_gen_id }}">{{ review_text }}</p>
                  {% endif %}

                  {% if review_author != blank %}
                    <p class="ai-wall-of-fame-author-{{ ai_gen_id }}">{{ review_author }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="ai-wall-of-fame-empty-state-{{ ai_gen_id }}">
        <p>Enable reviews below to get started</p>
      </div>
    {% endif %}
  </div>
</wall-of-fame-{{ ai_gen_id }}>

<script>
  (function() {
    class WallOfFame{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.isDragging = false;
        this.startX = 0;
        this.scrollLeft = 0;
      }

      connectedCallback() {
        this.carousel = this.querySelector('[data-carousel]');
        this.wrapper = this.querySelector('[data-wrapper]');
        
        if (this.carousel) {
          this.duplicateCards();
          this.setupDragScroll();
        }
      }

      duplicateCards() {
        const cards = Array.from(this.carousel.children);
        if (cards.length === 0) return;

        const cardsHTML = cards.map(card => card.outerHTML).join('');
        
        this.carousel.innerHTML += cardsHTML + cardsHTML;
      }

      setupDragScroll() {
        this.wrapper.addEventListener('mousedown', this.handleMouseDown.bind(this));
        this.wrapper.addEventListener('mouseleave', this.handleMouseLeave.bind(this));
        this.wrapper.addEventListener('mouseup', this.handleMouseUp.bind(this));
        this.wrapper.addEventListener('mousemove', this.handleMouseMove.bind(this));

        this.wrapper.addEventListener('touchstart', this.handleTouchStart.bind(this), { passive: true });
        this.wrapper.addEventListener('touchend', this.handleTouchEnd.bind(this));
        this.wrapper.addEventListener('touchmove', this.handleTouchMove.bind(this), { passive: true });

        this.wrapper.addEventListener('scroll', this.handleScroll.bind(this));
      }

      handleMouseDown(e) {
        this.isDragging = true;
        this.carousel.classList.add('is-dragging');
        this.startX = e.pageX - this.wrapper.offsetLeft;
        this.scrollLeft = this.wrapper.scrollLeft;
      }

      handleMouseLeave() {
        if (this.isDragging) {
          this.isDragging = false;
          this.carousel.classList.remove('is-dragging');
        }
      }

      handleMouseUp() {
        this.isDragging = false;
        this.carousel.classList.remove('is-dragging');
      }

      handleMouseMove(e) {
        if (!this.isDragging) return;
        e.preventDefault();
        const x = e.pageX - this.wrapper.offsetLeft;
        const walk = (x - this.startX) * 2;
        this.wrapper.scrollLeft = this.scrollLeft - walk;
      }

      handleTouchStart(e) {
        this.isDragging = true;
        this.carousel.classList.add('is-dragging');
        this.startX = e.touches[0].pageX - this.wrapper.offsetLeft;
        this.scrollLeft = this.wrapper.scrollLeft;
      }

      handleTouchEnd() {
        this.isDragging = false;
        this.carousel.classList.remove('is-dragging');
      }

      handleTouchMove(e) {
        if (!this.isDragging) return;
        const x = e.touches[0].pageX - this.wrapper.offsetLeft;
        const walk = (x - this.startX) * 2;
        this.wrapper.scrollLeft = this.scrollLeft - walk;
      }

      handleScroll() {
        const maxScroll = this.wrapper.scrollWidth - this.wrapper.clientWidth;
        
        if (this.wrapper.scrollLeft >= maxScroll - 10) {
          this.wrapper.scrollLeft = maxScroll / 3;
        } else if (this.wrapper.scrollLeft <= 10) {
          this.wrapper.scrollLeft = maxScroll / 3;
        }
      }
    }

    customElements.define('wall-of-fame-{{ ai_gen_id }}', WallOfFame{{ ai_gen_id }});
  })();
</script>

