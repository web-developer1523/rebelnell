{% doc %}
  @prompt
    two horizontal upload able icons with text columns, the text columns should be below the uploaded image , the text section should be fully editable (it should have the ability to link, bold, and add bullet points. The image size should be bigger, Icon size should be up to 600 px
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-icon-columns-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-icon-columns-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.column_gap }}px;
    align-items: flex-start;
    justify-content: center;
  }

  .ai-icon-column-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.horizontal_alignment }};
    gap: {{ block.settings.icon_text_gap }}px;
    max-width: 50%;
  }

  .ai-icon-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    padding: {{ block.settings.icon_padding }}px;
  }

  .ai-icon-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.icon_border_radius }}px;
  }

  .ai-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-icon-content-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-icon-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: 600;
    line-height: 1.3;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-icon-text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-icon-text-{{ ai_gen_id }} p {
    margin: 0 0 12px 0;
  }

  .ai-icon-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-icon-text-{{ ai_gen_id }} ul,
  .ai-icon-text-{{ ai_gen_id }} ol {
    margin: 0 0 12px 0;
    padding-left: 20px;
  }

  .ai-icon-text-{{ ai_gen_id }} li {
    margin-bottom: 6px;
  }

  .ai-icon-text-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-icon-text-{{ ai_gen_id }} a:hover {
    opacity: 0.8;
  }

  .ai-icon-text-{{ ai_gen_id }} strong {
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-icon-columns-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-icon-column-{{ ai_gen_id }} {
      max-width: 100%;
    }
  }
{% endstyle %}

<icon-columns-{{ ai_gen_id }} class="ai-icon-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-icon-columns-container-{{ ai_gen_id }}">
    <div class="ai-icon-column-{{ ai_gen_id }}">
      <div class="ai-icon-wrapper-{{ ai_gen_id }}">
        {% if block.settings.icon_1 %}
          <img
            src="{{ block.settings.icon_1 | image_url: width: 1200 }}"
            alt="{{ block.settings.icon_1.alt | escape }}"
            width="{{ block.settings.icon_size }}"
            height="{{ block.settings.icon_size }}"
            loading="lazy"
          >
        {% else %}
          <div class="ai-icon-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
      <div class="ai-icon-content-{{ ai_gen_id }}">
        {% if block.settings.heading_1 != blank %}
          <h3 class="ai-icon-heading-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h3>
        {% endif %}
        {% if block.settings.text_1 != blank %}
          <div class="ai-icon-text-{{ ai_gen_id }}">{{ block.settings.text_1 }}</div>
        {% endif %}
      </div>
    </div>

    <div class="ai-icon-column-{{ ai_gen_id }}">
      <div class="ai-icon-wrapper-{{ ai_gen_id }}">
        {% if block.settings.icon_2 %}
          <img
            src="{{ block.settings.icon_2 | image_url: width: 1200 }}"
            alt="{{ block.settings.icon_2.alt | escape }}"
            width="{{ block.settings.icon_size }}"
            height="{{ block.settings.icon_size }}"
            loading="lazy"
          >
        {% else %}
          <div class="ai-icon-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
      <div class="ai-icon-content-{{ ai_gen_id }}">
        {% if block.settings.heading_2 != blank %}
          <h3 class="ai-icon-heading-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h3>
        {% endif %}
        {% if block.settings.text_2 != blank %}
          <div class="ai-icon-text-{{ ai_gen_id }}">{{ block.settings.text_2 }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</icon-columns-{{ ai_gen_id }}>

<script>
  (function() {
    class IconColumns{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('icon-columns-{{ ai_gen_id }}', IconColumns{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Icon columns",
  "settings": [
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "image_picker",
      "id": "icon_1",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading",
      "default": "Feature heading"
    },
    {
      "type": "richtext",
      "id": "text_1",
      "label": "Text",
      "default": "<p>Add descriptive text about this feature</p>"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "image_picker",
      "id": "icon_2",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading",
      "default": "Feature heading"
    },
    {
      "type": "richtext",
      "id": "text_2",
      "label": "Text",
      "default": "<p>Add descriptive text about this feature</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "icon_text_gap",
      "label": "Icon to text gap",
      "min": 5,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Horizontal alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 60,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "icon_padding",
      "label": "Icon padding",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "icon_border_radius",
      "label": "Icon border radius",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "icon_background_color",
      "label": "Icon background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder color",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading spacing",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Icon columns"
    }
  ]
}
{% endschema %}
