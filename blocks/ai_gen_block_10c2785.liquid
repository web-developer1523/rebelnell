{% doc %}
  @prompt
    thin horizonatl hero image with adjustable header alignment, 4 product scrollable on mobile under the hero image, for desktop the 4 product images will aligh with the hero image size. add a header above the products, remove header product and reduce padding between product and hero, almost perfect. Now include add to cart button, So close. Make the alignment of the text and size adjustable for both mobile and desktop
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-products-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-hero-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.hero_height }}px;
    overflow: hidden;
  }

  .ai-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-text-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: {{ block.settings.text_color }};
    padding: 20px;
    max-width: 600px;
  }

  .ai-hero-text-overlay-{{ ai_gen_id }}--left {
    left: 0;
    text-align: left;
  }

  .ai-hero-text-overlay-{{ ai_gen_id }}--center {
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }

  .ai-hero-text-overlay-{{ ai_gen_id }}--right {
    right: 0;
    text-align: right;
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 10px;
    font-weight: 700;
  }

  .ai-hero-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
  }

  .ai-products-section-{{ ai_gen_id }} {
    padding: {{ block.settings.products_padding }}px 20px;
  }

  .ai-products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .ai-product-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-product-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
    margin-bottom: 12px;
  }

  .ai-product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-product-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 500;
    margin: 0;
  }

  .ai-product-price-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.price_color }};
    margin-bottom: 8px;
  }

  .ai-add-to-cart-btn-{{ ai_gen_id }} {
    width: 100%;
    padding: 10px 16px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    transition: background-color 0.3s ease;
  }

  .ai-add-to-cart-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-add-to-cart-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-container-{{ ai_gen_id }} {
      height: {{ block.settings.hero_height_mobile }}px;
    }

    .ai-hero-text-overlay-{{ ai_gen_id }} {
      transform: translateY(-50%);
    }

    .ai-hero-text-overlay-{{ ai_gen_id }}--left-mobile {
      left: 0;
      text-align: left;
    }

    .ai-hero-text-overlay-{{ ai_gen_id }}--center-mobile {
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
    }

    .ai-hero-text-overlay-{{ ai_gen_id }}--right-mobile {
      right: 0;
      left: auto;
      text-align: right;
    }

    .ai-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-hero-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }

    .ai-products-grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 15px;
      -webkit-overflow-scrolling: touch;
    }

    .ai-product-card-{{ ai_gen_id }} {
      flex: 0 0 70%;
      scroll-snap-align: start;
    }
  }
{% endstyle %}

<hero-products-{{ ai_gen_id }} class="ai-hero-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-container-{{ ai_gen_id }}">
    {% if block.settings.hero_image %}
      <img
        src="{{ block.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ block.settings.hero_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.hero_image.width }}"
        height="{{ block.settings.hero_image.height }}"
        class="ai-hero-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-hero-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-hero-text-overlay-{{ ai_gen_id }} ai-hero-text-overlay-{{ ai_gen_id }}--{{ block.settings.text_alignment }} ai-hero-text-overlay-{{ ai_gen_id }}--{{ block.settings.text_alignment_mobile }}-mobile">
        {% if block.settings.heading != blank %}
          <h2 class="ai-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-hero-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="ai-products-section-{{ ai_gen_id }}">
    <div class="ai-products-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign product = block.settings[product_key]
        %}

        {% if product != blank %}
          <div class="ai-product-card-{{ ai_gen_id }}">
            <a href="{{ product.url }}" class="ai-product-link-{{ ai_gen_id }}">
              <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 500 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    width="500"
                    height="500"
                    loading="lazy"
                    class="ai-product-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-product-placeholder-{{ ai_gen_id }}">
                    {{ 'product-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-product-info-{{ ai_gen_id }}">
                <h4 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h4>
                <div class="ai-product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
              </div>
            </a>
            <button
              class="ai-add-to-cart-btn-{{ ai_gen_id }}"
              data-product-id="{{ product.id }}"
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
              {% unless product.available %}disabled{% endunless %}
            >
              {% if product.available %}
                {{ block.settings.button_text }}
              {% else %}
                Sold out
              {% endif %}
            </button>
          </div>
        {% else %}
          <div class="ai-product-card-{{ ai_gen_id }}">
            <div class="ai-product-link-{{ ai_gen_id }}">
              <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
                <div class="ai-product-placeholder-{{ ai_gen_id }}">
                  {{ 'product-apparel-1' | placeholder_svg_tag }}
                </div>
              </div>
              <div class="ai-product-info-{{ ai_gen_id }}">
                <h4 class="ai-product-title-{{ ai_gen_id }}">Product {{ i }}</h4>
                <div class="ai-product-price-{{ ai_gen_id }}">$0.00</div>
              </div>
            </div>
            <button class="ai-add-to-cart-btn-{{ ai_gen_id }}" disabled>
              {{ block.settings.button_text }}
            </button>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</hero-products-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
        this.setupAddToCart();
      }

      setupAddToCart() {
        const buttons = this.querySelectorAll('.ai-add-to-cart-btn-{{ ai_gen_id }}');
        
        buttons.forEach((button) => {
          button.addEventListener('click', async (e) => {
            e.preventDefault();
            
            const variantId = button.getAttribute('data-variant-id');
            if (!variantId) return;

            const originalText = button.textContent;
            button.disabled = true;
            button.textContent = 'Adding...';

            try {
              const response = await fetch('/cart/add.js', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  id: variantId,
                  quantity: 1
                })
              });

              if (response.ok) {
                button.textContent = 'Added!';
                
                const cartEvent = new CustomEvent('cart:refresh', {
                  bubbles: true
                });
                document.documentElement.dispatchEvent(cartEvent);

                setTimeout(() => {
                  button.textContent = originalText;
                  button.disabled = false;
                }, 2000);
              } else {
                throw new Error('Failed to add to cart');
              }
            } catch (error) {
              button.textContent = 'Error';
              setTimeout(() => {
                button.textContent = originalText;
                button.disabled = false;
              }, 2000);
            }
          });
        });
      }
    }

    customElements.define('hero-products-{{ ai_gen_id }}', HeroProducts{{ ai_gen_id }});
  })();
</script>

