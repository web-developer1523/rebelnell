{% doc %}
  @prompt
    a featured collection with one large hero image at the top. Put the text over the image with editable alignment, positioned at the bottom center on both mobile and desktop. Add a "Shop All" button on the featured image. Remove the side images and reduce white space at the top., Please add the ability to adjust the size and position of the title and the descriptive text, allowing for greater flexibility.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-featured-collection-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-featured-collection-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
  }

  .ai-featured-collection-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-featured-collection-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-featured-collection-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-featured-collection-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    pointer-events: none;
  }

  .ai-featured-collection-content-{{ ai_gen_id }} {
    position: absolute;
    {% if block.settings.vertical_position == 'top' %}
      top: {{ block.settings.content_vertical_offset }}px;
    {% elsif block.settings.vertical_position == 'middle' %}
      top: 50%;
      transform: translateY(-50%);
    {% else %}
      bottom: {{ block.settings.content_vertical_offset }}px;
    {% endif %}
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.text_alignment }};
    gap: {{ block.settings.content_gap }}px;
    padding: 0 {{ block.settings.content_horizontal_padding }}px;
    z-index: 2;
  }

  .ai-featured-collection-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0;
    text-align: {{ block.settings.text_alignment }};
    line-height: {{ block.settings.title_line_height }};
    max-width: {{ block.settings.title_max_width }}px;
  }

  .ai-featured-collection-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0;
    text-align: {{ block.settings.text_alignment }};
    line-height: {{ block.settings.description_line_height }};
    max-width: {{ block.settings.description_max_width }}px;
  }

  .ai-featured-collection-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-featured-collection-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_image_height }}px;
    }

    .ai-featured-collection-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .ai-featured-collection-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_description_size }}px;
    }

    .ai-featured-collection-content-{{ ai_gen_id }} {
      {% if block.settings.vertical_position == 'top' %}
        top: {{ block.settings.mobile_content_vertical_offset }}px;
      {% elsif block.settings.vertical_position == 'middle' %}
        top: 50%;
        transform: translateY(-50%);
      {% else %}
        bottom: {{ block.settings.mobile_content_vertical_offset }}px;
      {% endif %}
      padding: 0 {{ block.settings.mobile_content_horizontal_padding }}px;
      gap: {{ block.settings.mobile_content_gap }}px;
    }
  }
{% endstyle %}

<div class="ai-featured-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-collection-hero-{{ ai_gen_id }}">
    <div class="ai-featured-collection-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.collection_image %}
        <img
          src="{{ block.settings.collection_image | image_url: width: 2000 }}"
          alt="{{ block.settings.collection_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.collection_image.width }}"
          height="{{ block.settings.collection_image.height }}"
          class="ai-featured-collection-image-{{ ai_gen_id }}"
        >
      {% elsif block.settings.collection and block.settings.collection.image %}
        <img
          src="{{ block.settings.collection.image | image_url: width: 2000 }}"
          alt="{{ block.settings.collection.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.collection.image.width }}"
          height="{{ block.settings.collection.image.height }}"
          class="ai-featured-collection-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-featured-collection-placeholder-{{ ai_gen_id }}">
          {{ 'collection-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}

      {% if block.settings.overlay_opacity > 0 %}
        <div class="ai-featured-collection-overlay-{{ ai_gen_id }}"></div>
      {% endif %}

      <div class="ai-featured-collection-content-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-featured-collection-title-{{ ai_gen_id }}">
            {{ block.settings.title }}
          </h2>
        {% elsif block.settings.collection %}
          <h2 class="ai-featured-collection-title-{{ ai_gen_id }}">
            {{ block.settings.collection.title }}
          </h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-featured-collection-description-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% elsif block.settings.collection and block.settings.collection.description != blank %}
          <div class="ai-featured-collection-description-{{ ai_gen_id }}">
            {{ block.settings.collection.description }}
          </div>
        {% endif %}

        {% if block.settings.collection %}
          <a
            href="{{ block.settings.collection.url }}"
            class="ai-featured-collection-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        {% elsif block.settings.button_link %}
          <a
            href="{{ block.settings.button_link }}"
            class="ai-featured-collection-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        {% else %}
          <span class="ai-featured-collection-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </span>
        {% endif %}
      </div>
    </div>
  </div>
</div>

