    </div>
  </div>

  <div class="ai-parallel-sections-column-{{ ai_gen_id }}">
    {% if block.settings.right_main_title != blank %}
      <h2 class="ai-parallel-sections-main-title-{{ ai_gen_id }}" style="text-align: {{ block.settings.right_main_title_alignment }}; color: {{ block.settings.text_color }};">{{ block.settings.right_main_title }}</h2>
    {% endif %}

    <div class="ai-parallel-sections-item-right-{{ ai_gen_id }}" 
         {% if block.settings.right_item_1_image %}
           style="background-image: url('{{ block.settings.right_item_1_image | image_url: width: 800 }}');"
         {% endif %}>
      {% if block.settings.right_item_1_video %}
        <video class="ai-parallel-sections-video-{{ ai_gen_id }}" autoplay muted loop playsinline>
          <source src="{{ block.settings.right_item_1_video }}" type="video/mp4">
        </video>
      {% endif %}
      {% unless block.settings.right_item_1_image or block.settings.right_item_1_video %}
