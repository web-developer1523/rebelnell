          <h3 class="ai-parallel-sections-item-title-{{ ai_gen_id }}">{{ block.settings.left_item_1_title }}</h3>
        {% endif %}
        {% if block.settings.left_item_1_subtitle != blank %}
          <p class="ai-parallel-sections-item-subtitle-{{ ai_gen_id }}">{{ block.settings.left_item_1_subtitle }}</p>
