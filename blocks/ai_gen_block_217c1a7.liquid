{% doc %}
  @prompt
    a featured collection with one large image and several small images around it to help tell the story of the collection better. make the collection images include  add to cart and a button on the featured image of the section that say shop all, can you remove some of the white space in the top and have the products scrolling below the main image, this is perfect just remove the side images. Put the text over the image, add the products for the collection below the featured collection that are scrollable and include add to cart, i want to be able to edit the alignment of all the text, I want to be able to put the text in the hero image to the bottom center of the image in both mobile and desktop. the product text should be center aligned, Make the product images clickable links that navigate to each product's detail page when clicked.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-featured-collection-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-featured-collection-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-featured-collection-hero-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-featured-collection-hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-featured-collection-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-featured-collection-hero-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.text_vertical_position }}%;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 600px;
    text-align: {{ block.settings.text_alignment }};
    z-index: 2;
  }

  .ai-featured-collection-hero-title-{{ ai_gen_id }} {
    color: {{ block.settings.hero_text_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .ai-featured-collection-hero-description-{{ ai_gen_id }} {
    color: {{ block.settings.hero_text_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0 0 {{ block.settings.description_spacing }}px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .ai-featured-collection-hero-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 30px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-featured-collection-hero-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-featured-collection-products-{{ ai_gen_id }} {
    margin-top: {{ block.settings.products_spacing }}px;
    overflow: hidden;
  }

  .ai-featured-collection-products-scroll-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 20px 0;
    -webkit-overflow-scrolling: touch;
  }

  .ai-featured-collection-products-scroll-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 8px;
  }

  .ai-featured-collection-products-scroll-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4px;
  }

  .ai-featured-collection-products-scroll-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 4px;
  }

  .ai-featured-collection-products-scroll-{{ ai_gen_id }}::-webkit-scrollbar-thumb:hover {
    background: #555;
  }

  .ai-featured-collection-product-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.product_card_width }}px;
    background-color: {{ block.settings.product_card_bg }};
    border-radius: {{ block.settings.product_card_border_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .ai-featured-collection-product-image-link-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-featured-collection-product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-collection-product-info-{{ ai_gen_id }} {
    padding: 15px;
    text-align: center;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-featured-collection-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_text_color }};
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .ai-featured-collection-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_text_color }};
    margin: 0 0 12px;
  }

  .ai-featured-collection-add-to-cart-{{ ai_gen_id }} {
    padding: 10px 20px;
    background-color: {{ block.settings.add_to_cart_bg_color }};
    color: {{ block.settings.add_to_cart_text_color }};
    border: none;
    border-radius: {{ block.settings.add_to_cart_border_radius }}px;
    cursor: pointer;
    font-size: {{ block.settings.add_to_cart_font_size }}px;
    transition: background-color 0.3s ease;
    margin-top: auto;
  }

  .ai-featured-collection-add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.add_to_cart_hover_bg_color }};
  }

  .ai-featured-collection-add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-featured-collection-empty-products-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 16px;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection-hero-content-{{ ai_gen_id }} {
      bottom: {{ block.settings.text_vertical_position_mobile }}%;
    }

    .ai-featured-collection-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-featured-collection-hero-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.8 }}px;
    }

    .ai-featured-collection-product-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.product_card_width | times: 0.8 }}px;
    }
  }
{% endstyle %}

<featured-collection-{{ ai_gen_id }}
  class="ai-featured-collection-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-featured-collection-hero-{{ ai_gen_id }}">
    {% if block.settings.hero_image %}
      <img
        src="{{ block.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ block.settings.hero_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.hero_image.width }}"
        height="{{ block.settings.hero_image.height }}"
        class="ai-featured-collection-hero-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-featured-collection-hero-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-featured-collection-empty-state-{{ ai_gen_id }}">
          Next, add a hero image
        </div>
      </div>
    {% endif %}

    <div class="ai-featured-collection-hero-content-{{ ai_gen_id }}">
      {% if block.settings.hero_title != blank %}
        <h2 class="ai-featured-collection-hero-title-{{ ai_gen_id }}">
          {{ block.settings.hero_title }}
        </h2>
      {% endif %}

      {% if block.settings.hero_description != blank %}
        <div class="ai-featured-collection-hero-description-{{ ai_gen_id }}">
          {{ block.settings.hero_description }}
        </div>
      {% endif %}

      {% if block.settings.collection != blank %}
        <a
          href="{{ block.settings.collection.url }}"
          class="ai-featured-collection-hero-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>

  <div class="ai-featured-collection-products-{{ ai_gen_id }}">
    {% if block.settings.collection != blank and block.settings.collection.products.size > 0 %}
      <div class="ai-featured-collection-products-scroll-{{ ai_gen_id }}">
        {% for product in block.settings.collection.products limit: block.settings.products_limit %}
          <div class="ai-featured-collection-product-card-{{ ai_gen_id }}">
            <a
              href="{{ product.url }}"
              class="ai-featured-collection-product-image-link-{{ ai_gen_id }}"
            >
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="600"
                  class="ai-featured-collection-product-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-featured-collection-product-image-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>

            <div class="ai-featured-collection-product-info-{{ ai_gen_id }}">
              <h3 class="ai-featured-collection-product-title-{{ ai_gen_id }}">
                {{ product.title }}
              </h3>

              <div class="ai-featured-collection-product-price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>

              <button
                class="ai-featured-collection-add-to-cart-{{ ai_gen_id }}"
                data-product-id="{{ product.id }}"
                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                {% unless product.available %}disabled{% endunless %}
              >
                {% if product.available %}
                  {{ block.settings.add_to_cart_button_text }}
                {% else %}
                  Sold out
                {% endif %}
              </button>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-featured-collection-empty-products-{{ ai_gen_id }}">
        Next, select a collection to display products
      </div>
    {% endif %}
  </div>
</featured-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.addToCartButtons = this.querySelectorAll('.ai-featured-collection-add-to-cart-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.addToCartButtons.forEach((button) => {
          button.addEventListener('click', this.handleAddToCart.bind(this));
        });
      }

      async handleAddToCart(event) {
        const button = event.target;
        const variantId = button.dataset.variantId;

        if (!variantId || button.disabled) return;

        button.disabled = true;
        const originalText = button.textContent;
        button.textContent = 'Adding...';

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: 1
            })
          });

          if (response.ok) {
            button.textContent = 'Added!';
            
            const cartCountElements = document.querySelectorAll('[data-cart-count]');
            const cartResponse = await fetch('/cart.js');
            const cart = await cartResponse.json();
            
            cartCountElements.forEach(element => {
              element.textContent = cart.item_count;
            });

            setTimeout(() => {
              button.textContent = originalText;
              button.disabled = false;
            }, 2000);
          } else {
            throw new Error('Failed to add to cart');
          }
        } catch (error) {
          button.textContent = 'Error';
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);
        }
      }
    }

    customElements.define('featured-collection-{{ ai_gen_id }}', FeaturedCollection{{ ai_gen_id }});
  })();
</script>

