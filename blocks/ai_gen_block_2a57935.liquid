{% doc %}
  @prompt
    one large image and then a block of 4 products to the right of the large image, include add to cart with the products
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-products-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-image-products-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-image-products-large-image-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-image-products-large-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-image-products-large-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-products-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 400px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-image-products-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-image-products-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-products-grid-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-image-products-product-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-image-products-product-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.product_border_radius }}px;
    background-color: #f4f4f4;
  }

  .ai-image-products-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-products-product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-image-products-product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-image-products-product-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-image-products-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-image-products-product-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-image-products-product-title-{{ ai_gen_id }} a:hover {
    opacity: 0.7;
  }

  .ai-image-products-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
  }

  .ai-image-products-add-to-cart-{{ ai_gen_id }} {
    padding: 10px 16px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    width: 100%;
  }

  .ai-image-products-add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-image-products-add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-image-products-empty-product-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
    color: #999;
    font-size: 13px;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-image-products-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-image-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstyle %}

<image-products-{{ ai_gen_id }}
  class="ai-image-products-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-image-products-container-{{ ai_gen_id }}">
    <div class="ai-image-products-large-image-{{ ai_gen_id }}">
      <div class="ai-image-products-large-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.large_image %}
          <img
            src="{{ block.settings.large_image | image_url: width: 1200 }}"
            alt="{{ block.settings.large_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.large_image.width }}"
            height="{{ block.settings.large_image.height }}"
          >
        {% else %}
          <div class="ai-image-products-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-image-products-empty-state-{{ ai_gen_id }}">
              Add a large image
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-image-products-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign product = block.settings[product_key]
        %}

        <div class="ai-image-products-product-{{ ai_gen_id }}">
          {% if product != blank %}
            <a
              href="{{ product.url }}"
              class="ai-image-products-product-image-{{ ai_gen_id }}"
            >
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              {% else %}
                <div class="ai-image-products-product-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>

            <div class="ai-image-products-product-info-{{ ai_gen_id }}">
              <h3 class="ai-image-products-product-title-{{ ai_gen_id }}">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              <div class="ai-image-products-product-price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>

              {% if block.settings.show_add_to_cart %}
                <button
                  class="ai-image-products-add-to-cart-{{ ai_gen_id }}"
                  data-product-id="{{ product.id }}"
                  data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  {% unless product.available %}disabled{% endunless %}
                >
                  {% if product.available %}
                    {{ block.settings.button_text }}
                  {% else %}
                    {{ block.settings.sold_out_text }}
                  {% endif %}
                </button>
              {% endif %}
            </div>
          {% else %}
            <div class="ai-image-products-empty-product-{{ ai_gen_id }}">
              <div class="ai-image-products-product-image-{{ ai_gen_id }}">
                <div class="ai-image-products-product-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              </div>
              <div>Add product {{ i }}</div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</image-products-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAddToCart();
      }

      setupAddToCart() {
        const buttons = this.querySelectorAll('.ai-image-products-add-to-cart-{{ ai_gen_id }}');
        
        buttons.forEach((button) => {
          button.addEventListener('click', (event) => {
            event.preventDefault();
            
            const variantId = button.getAttribute('data-variant-id');
            const originalText = button.textContent;
            
            button.disabled = true;
            button.textContent = '{{ block.settings.adding_text }}';
            
            fetch('/cart/add.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                id: variantId,
                quantity: 1
              })
            })
            .then(response => response.json())
            .then(data => {
              button.textContent = '{{ block.settings.added_text }}';
              
              setTimeout(() => {
                button.textContent = originalText;
                button.disabled = false;
              }, 2000);
              
              if (window.theme && window.theme.cart) {
                window.theme.cart.getCart();
              }
              
              document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
                bubbles: true
              }));
            })
            .catch((error) => {
              console.error('Error:', error);
              button.textContent = originalText;
              button.disabled = false;
            });
          });
        });
      }
    }

    customElements.define('image-products-{{ ai_gen_id }}', ImageProducts{{ ai_gen_id }});
  })();
</script>

