{% doc %}
  @prompt
    text with a small image that connects to a video, move the play icon down 25% in the image.
    Center the text and the thumbmail in center of the page, Add a stacked before and after image to the right of the video
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-text-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-video-text-container-{{ ai_gen_id }} {
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    justify-content: center;
    gap: {{ block.settings.spacing }}px;
    flex-direction: {{ block.settings.layout }};
  }

  .ai-video-text-content-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
    text-align: center;
  }

  .ai-video-text-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-video-text-description-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
  }

  .ai-video-text-media-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.media_spacing }}px;
    align-items: center;
  }

  .ai-video-text-image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_width }}px;
    position: relative;
    cursor: pointer;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-text-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-video-text-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-video-text-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-video-text-play-icon-{{ ai_gen_id }} {
    position: absolute;
    top: 62.5%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.play_icon_size }}px;
    height: {{ block.settings.play_icon_size }}px;
    background-color: {{ block.settings.play_icon_bg }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, background-color 0.3s ease;
    pointer-events: none;
  }

  .ai-video-text-image-wrapper-{{ ai_gen_id }}:hover .ai-video-text-play-icon-{{ ai_gen_id }} {
    transform: translate(-50%, -50%) scale(1.1);
    background-color: {{ block.settings.play_icon_hover_bg }};
  }

  .ai-video-text-play-icon-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    fill: {{ block.settings.play_icon_color }};
    margin-left: 3px;
  }

  .ai-video-text-before-after-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.before_after_spacing }}px;
  }

  .ai-video-text-before-after-item-{{ ai_gen_id }} {
    width: {{ block.settings.before_after_width }}px;
    height: {{ block.settings.before_after_width }}px;
    border-radius: {{ block.settings.before_after_border_radius }}px;
    overflow: hidden;
    position: relative;
  }

  .ai-video-text-before-after-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-video-text-before-after-label-{{ ai_gen_id }} {
    position: absolute;
    top: 8px;
    left: 8px;
    background-color: {{ block.settings.label_bg_color }};
    color: {{ block.settings.label_text_color }};
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .ai-video-text-modal-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .ai-video-text-modal-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-video-text-modal-content-{{ ai_gen_id }} {
    position: relative;
    width: 90%;
    max-width: 900px;
    aspect-ratio: 16 / 9;
  }

  .ai-video-text-modal-close-{{ ai_gen_id }} {
    position: absolute;
    top: -40px;
    right: 0;
    background: none;
    border: none;
    color: #ffffff;
    font-size: 32px;
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .ai-video-text-modal-close-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-video-text-video-container-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #000000;
  }

  .ai-video-text-video-container-{{ ai_gen_id }} iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  @media screen and (max-width: 749px) {
    .ai-video-text-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-video-text-media-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      width: 100%;
    }

    .ai-video-text-image-wrapper-{{ ai_gen_id }} {
      width: 100%;
      max-width: {{ block.settings.image_width }}px;
      height: auto;
      aspect-ratio: 1;
    }

    .ai-video-text-before-after-{{ ai_gen_id }} {
      flex-direction: row;
      width: 100%;
      justify-content: center;
    }

    .ai-video-text-before-after-item-{{ ai_gen_id }} {
      width: 100%;
      max-width: {{ block.settings.before_after_width }}px;
      height: auto;
      aspect-ratio: 1;
    }

    .ai-video-text-modal-content-{{ ai_gen_id }} {
      width: 95%;
    }

    .ai-video-text-modal-close-{{ ai_gen_id }} {
      top: -35px;
      font-size: 28px;
    }
  }
{% endstyle %}

<video-text-block-{{ ai_gen_id }}
  class="ai-video-text-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-text-container-{{ ai_gen_id }}">
    <div class="ai-video-text-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-video-text-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-video-text-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>

    <div class="ai-video-text-media-wrapper-{{ ai_gen_id }}">
      <div
        class="ai-video-text-image-wrapper-{{ ai_gen_id }}"
        data-video-trigger
      >
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 400 }}"
            alt="{{ block.settings.image.alt | escape }}"
            class="ai-video-text-image-{{ ai_gen_id }}"
            loading="lazy"
            width="400"
            height="400"
          >
        {% else %}
          <div class="ai-video-text-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        <div class="ai-video-text-play-icon-{{ ai_gen_id }}">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <polygon points="5,3 19,12 5,21"></polygon>
          </svg>
        </div>
      </div>

      {% if block.settings.show_before_after %}
        <div class="ai-video-text-before-after-{{ ai_gen_id }}">
          <div class="ai-video-text-before-after-item-{{ ai_gen_id }}">
            {% if block.settings.before_image %}
              <img
                src="{{ block.settings.before_image | image_url: width: 400 }}"
                alt="{{ block.settings.before_image.alt | escape }}"
                class="ai-video-text-before-after-image-{{ ai_gen_id }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {% else %}
              <div class="ai-video-text-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
            <div class="ai-video-text-before-after-label-{{ ai_gen_id }}">{{ block.settings.before_label }}</div>
          </div>

          <div class="ai-video-text-before-after-item-{{ ai_gen_id }}">
            {% if block.settings.after_image %}
              <img
                src="{{ block.settings.after_image | image_url: width: 400 }}"
                alt="{{ block.settings.after_image.alt | escape }}"
                class="ai-video-text-before-after-image-{{ ai_gen_id }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {% else %}
              <div class="ai-video-text-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
            <div class="ai-video-text-before-after-label-{{ ai_gen_id }}">{{ block.settings.after_label }}</div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <div
    class="ai-video-text-modal-{{ ai_gen_id }}"
    data-video-modal
  >
    <div class="ai-video-text-modal-content-{{ ai_gen_id }}">
      <button
        class="ai-video-text-modal-close-{{ ai_gen_id }}"
        data-modal-close
        aria-label="Close video"
      >
        ×
      </button>
      <div
        class="ai-video-text-video-container-{{ ai_gen_id }}"
        data-video-container
      ></div>
    </div>
  </div>
</video-text-block-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoTextBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.videoUrl = {{ block.settings.video_url | json }};
      }

      connectedCallback() {
        this.trigger = this.querySelector('[data-video-trigger]');
        this.modal = this.querySelector('[data-video-modal]');
        this.closeBtn = this.querySelector('[data-modal-close]');
        this.videoContainer = this.querySelector('[data-video-container]');

        this.setupEventListeners();
      }

      setupEventListeners() {
        if (this.trigger) {
          this.trigger.addEventListener('click', () => this.openModal());
        }

        if (this.closeBtn) {
          this.closeBtn.addEventListener('click', () => this.closeModal());
        }

        if (this.modal) {
          this.modal.addEventListener('click', (e) => {
            if (e.target === this.modal) {
              this.closeModal();
            }
          });
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.modal.classList.contains('active')) {
            this.closeModal();
          }
        });
      }

      openModal() {
        if (!this.videoUrl) return;

        const videoId = this.extractVideoId(this.videoUrl);
        if (!videoId) return;

        const embedUrl = this.getEmbedUrl(videoId);
        const iframe = document.createElement('iframe');
        iframe.src = embedUrl;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;

        this.videoContainer.innerHTML = '';
        this.videoContainer.appendChild(iframe);
        this.modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closeModal() {
        this.modal.classList.remove('active');
        this.videoContainer.innerHTML = '';
        document.body.style.overflow = '';
      }

      extractVideoId(url) {
        if (!url) return null;

        if (url.includes('youtube.com') || url.includes('youtu.be')) {
          const youtubeRegex = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/;
          const match = url.match(youtubeRegex);
          return match ? match[1] : null;
        }

        if (url.includes('vimeo.com')) {
          const vimeoRegex = /vimeo\.com\/(?:.*\/)?(\d+)/;
          const match = url.match(vimeoRegex);
          return match ? match[1] : null;
        }

        return null;
      }

      getEmbedUrl(videoId) {
        if (this.videoUrl.includes('youtube.com') || this.videoUrl.includes('youtu.be')) {
          return `https://www.youtube.com/embed/${videoId}?autoplay=1`;
        }

        if (this.videoUrl.includes('vimeo.com')) {
          return `https://player.vimeo.com/video/${videoId}?autoplay=1`;
        }

        return '';
      }
    }

    customElements.define('video-text-block-{{ ai_gen_id }}', VideoTextBlock{{ ai_gen_id }});
  })();
</script>

