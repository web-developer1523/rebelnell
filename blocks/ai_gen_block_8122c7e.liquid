{% doc %}
  @prompt
    A featured collection section with a full-width hero image and overlaid text positioned at the bottom center (editable alignment for both mobile and desktop). The hero image includes a "Shop All" button. Below the hero, a horizontally scrollable product row displays collection items with square (1:1) product images using object-fit cover. Each product card has center-aligned text and an "Add to Cart" button. Clicking any product image navigates to the product page. The title and description support customizable line height, font size, text color, and text shadow.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-featured-collection-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.hero_height }}px;
    overflow: hidden;
  }

  .ai-featured-collection-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.hero_height }}px;
    object-fit: cover;
  }

  .ai-featured-collection-hero-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.hero_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-featured-collection-hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-featured-collection-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-featured-collection-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    display: flex;
    align-items: {{ block.settings.text_position_vertical }};
    justify-content: {{ block.settings.text_position_horizontal }};
    padding: 40px;
  }

  .ai-featured-collection-hero-content-{{ ai_gen_id }} {
    text-align: center;
    max-width: 800px;
  }

  .ai-featured-collection-hero-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_font_size }}px;
    line-height: {{ block.settings.title_line_height }};
    margin: 0 0 16px;
    text-shadow: {{ block.settings.text_shadow_horizontal }}px {{ block.settings.text_shadow_vertical }}px {{ block.settings.text_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.text_shadow_opacity }});
  }

  .ai-featured-collection-hero-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_font_size }}px;
    line-height: {{ block.settings.description_line_height }};
    margin: 0 0 24px;
    text-shadow: {{ block.settings.text_shadow_horizontal }}px {{ block.settings.text_shadow_vertical }}px {{ block.settings.text_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.text_shadow_opacity }});
  }

  .ai-featured-collection-hero-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-featured-collection-hero-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-featured-collection-products-{{ ai_gen_id }} {
    padding: {{ block.settings.products_padding_top }}px 20px {{ block.settings.products_padding_bottom }}px;
    background-color: {{ block.settings.products_bg_color }};
  }

  .ai-featured-collection-products-scroll-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_gap }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.scrollbar_color }} transparent;
  }

  .ai-featured-collection-products-scroll-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 8px;
  }

  .ai-featured-collection-products-scroll-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: transparent;
  }

  .ai-featured-collection-products-scroll-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background-color: {{ block.settings.scrollbar_color }};
    border-radius: 4px;
  }

  .ai-featured-collection-product-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.product_card_width }}px;
    display: flex;
    flex-direction: column;
  }

  .ai-featured-collection-product-image-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    margin-bottom: 12px;
    border-radius: {{ block.settings.product_image_border_radius }}px;
  }

  .ai-featured-collection-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-featured-collection-product-image-link-{{ ai_gen_id }}:hover .ai-featured-collection-product-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-featured-collection-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-collection-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-featured-collection-product-info-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-featured-collection-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_font_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .ai-featured-collection-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_font_size }}px;
    color: {{ block.settings.product_price_color }};
    margin: 0 0 12px;
  }

  .ai-featured-collection-add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 10px 20px;
    background-color: {{ block.settings.add_to_cart_bg_color }};
    color: {{ block.settings.add_to_cart_text_color }};
    border: none;
    border-radius: {{ block.settings.add_to_cart_border_radius }}px;
    font-size: {{ block.settings.add_to_cart_font_size }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-featured-collection-add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.add_to_cart_hover_bg_color }};
  }

  .ai-featured-collection-add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection-hero-overlay-{{ ai_gen_id }} {
      align-items: {{ block.settings.text_position_vertical_mobile }};
      justify-content: {{ block.settings.text_position_horizontal_mobile }};
      padding: 20px;
    }

    .ai-featured-collection-hero-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_font_size }}px * 0.7);
    }

    .ai-featured-collection-hero-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_font_size }}px * 0.85);
    }

    .ai-featured-collection-product-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.product_card_width_mobile }}px;
    }
  }
{% endstyle %}

<featured-collection-{{ ai_gen_id }} class="ai-featured-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-collection-hero-{{ ai_gen_id }}">
    {% if block.settings.hero_image %}
      <img
        src="{{ block.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ block.settings.hero_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.hero_image.width }}"
        height="{{ block.settings.hero_image.height }}"
        class="ai-featured-collection-hero-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-featured-collection-hero-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-featured-collection-empty-state-{{ ai_gen_id }}">
          Next, add a hero image
        </div>
      </div>
    {% endif %}

    <div class="ai-featured-collection-hero-overlay-{{ ai_gen_id }}">
      <div class="ai-featured-collection-hero-content-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-featured-collection-hero-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-featured-collection-hero-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}

        {% if block.settings.collection != blank %}
          <a href="{{ block.settings.collection.url }}" class="ai-featured-collection-hero-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="ai-featured-collection-products-{{ ai_gen_id }}">
    {% if block.settings.collection != blank and block.settings.collection.products.size > 0 %}
      <div class="ai-featured-collection-products-scroll-{{ ai_gen_id }}">
        {% for product in block.settings.collection.products limit: block.settings.products_limit %}
          <div class="ai-featured-collection-product-card-{{ ai_gen_id }}">
            <a href="{{ product.url }}" class="ai-featured-collection-product-image-link-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="600"
                  class="ai-featured-collection-product-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-featured-collection-product-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>

            <div class="ai-featured-collection-product-info-{{ ai_gen_id }}">
              <h3 class="ai-featured-collection-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              <div class="ai-featured-collection-product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>

              <form action="/cart/add" method="post" enctype="multipart/form-data">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button
                  type="submit"
                  class="ai-featured-collection-add-to-cart-{{ ai_gen_id }}"
                  {% unless product.available %}disabled{% endunless %}
                >
                  {% if product.available %}
                    {{ block.settings.add_to_cart_text }}
                  {% else %}
                    Sold out
                  {% endif %}
                </button>
              </form>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-featured-collection-empty-state-{{ ai_gen_id }}" style="text-align: center; padding: 40px; color: #666;">
        Next, select a collection to display products
      </div>
    {% endif %}
  </div>
</featured-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.forms = this.querySelectorAll('form[action="/cart/add"]');
        this.setupAddToCart();
      }

      setupAddToCart() {
        this.forms.forEach((form) => {
          form.addEventListener('submit', (event) => {
            event.preventDefault();
            const formData = new FormData(form);
            const button = form.querySelector('button[type="submit"]');
            const originalText = button.textContent;

            button.disabled = true;
            button.textContent = 'Adding...';

            fetch('/cart/add.js', {
              method: 'POST',
              body: formData
            })
            .then(response => response.json())
            .then(data => {
              button.textContent = 'Added!';
              setTimeout(() => {
                button.textContent = originalText;
                button.disabled = false;
              }, 2000);

              if (window.theme && window.theme.cart) {
                window.theme.cart.getCart();
              }
            })
            .catch(error => {
              button.textContent = 'Error';
              setTimeout(() => {
                button.textContent = originalText;
                button.disabled = false;
              }, 2000);
            });
          });
        });
      }
    }

    customElements.define('featured-collection-{{ ai_gen_id }}', FeaturedCollection{{ ai_gen_id }});
  })();
</script>

