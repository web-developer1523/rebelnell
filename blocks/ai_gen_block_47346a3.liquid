{% doc %}
  @prompt
    I need a hero that can be video or an image with the ability to edit text color, size, and alignment. It should also have the capability to have two buttons at once, the buttons should be side be side instead of stacked on mobile, text alignment should be editable for both desktop and mobile, add alignment for text for both mobile and desktop and allow me to choose what alignment the text block as a whole , I want to also be able to move the text to the bottom left of the mobile image, I want an option for a mobile version and a desktop version of the video, I want to put the text in the bottom center
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-hero-media-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.height_desktop }}px;
  }

  .ai-hero-media-{{ ai_gen_id }} img,
  .ai-hero-media-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-hero-media-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-media-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: {{ block.settings.content_position_desktop }};
    justify-content: {{ block.settings.content_alignment_desktop }};
    padding: 40px;
    z-index: 2;
  }

  .ai-hero-text-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.text_max_width }}px;
    text-align: {{ block.settings.text_align_desktop }};
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-hero-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 24px;
    line-height: 1.4;
  }

  .ai-hero-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: {{ block.settings.text_align_desktop }};
  }

  .ai-hero-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 28px;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .ai-hero-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_primary_bg }};
    color: {{ block.settings.button_primary_color }};
  }

  .ai-hero-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_primary_bg_hover }};
  }

  .ai-hero-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_bg }};
    color: {{ block.settings.button_secondary_color }};
  }

  .ai-hero-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_bg_hover }};
  }

  .ai-hero-video-desktop-{{ ai_gen_id }} {
    display: block;
  }

  .ai-hero-video-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-hero-image-desktop-{{ ai_gen_id }} {
    display: block;
  }

  .ai-hero-image-mobile-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-media-{{ ai_gen_id }} {
      height: {{ block.settings.height_mobile }}px;
    }

    .ai-hero-content-{{ ai_gen_id }} {
      align-items: {{ block.settings.content_position_mobile }};
      justify-content: {{ block.settings.content_alignment_mobile }};
      padding: 20px;
    }

    .ai-hero-text-wrapper-{{ ai_gen_id }} {
      text-align: {{ block.settings.text_align_mobile }};
    }

    .ai-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-hero-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }

    .ai-hero-buttons-{{ ai_gen_id }} {
      justify-content: {{ block.settings.text_align_mobile }};
      flex-direction: row;
    }

    .ai-hero-button-{{ ai_gen_id }} {
      padding: 12px 20px;
      font-size: 14px;
    }

    .ai-hero-video-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-video-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero-image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-image-mobile-{{ ai_gen_id }} {
      display: block;
    }
  }
{% endstyle %}

<div class="ai-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-media-{{ ai_gen_id }}">
    {% if block.settings.media_type == 'video' %}
      {% if block.settings.video_desktop != blank %}
        <video
          class="ai-hero-video-desktop-{{ ai_gen_id }}"
          autoplay
          muted
          loop
          playsinline
        >
          <source src="{{ block.settings.video_desktop }}" type="video/mp4">
        </video>
      {% else %}
        <div class="ai-hero-media-placeholder-{{ ai_gen_id }} ai-hero-video-desktop-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-hero-empty-state-{{ ai_gen_id }}">
            Add a desktop video
          </div>
        </div>
      {% endif %}

      {% if block.settings.video_mobile != blank %}
        <video
          class="ai-hero-video-mobile-{{ ai_gen_id }}"
          autoplay
          muted
          loop
          playsinline
        >
          <source src="{{ block.settings.video_mobile }}" type="video/mp4">
        </video>
      {% elsif block.settings.video_desktop != blank %}
        <video
          class="ai-hero-video-mobile-{{ ai_gen_id }}"
          autoplay
          muted
          loop
          playsinline
        >
          <source src="{{ block.settings.video_desktop }}" type="video/mp4">
        </video>
      {% else %}
        <div class="ai-hero-media-placeholder-{{ ai_gen_id }} ai-hero-video-mobile-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-hero-empty-state-{{ ai_gen_id }}">
            Add a mobile video
          </div>
        </div>
      {% endif %}
    {% else %}
      {% if block.settings.image_desktop != blank %}
        <img
          class="ai-hero-image-desktop-{{ ai_gen_id }}"
          src="{{ block.settings.image_desktop | image_url: width: 2000 }}"
          alt="{{ block.settings.image_desktop.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_desktop.width }}"
          height="{{ block.settings.image_desktop.height }}"
        >
      {% else %}
        <div class="ai-hero-media-placeholder-{{ ai_gen_id }} ai-hero-image-desktop-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-hero-empty-state-{{ ai_gen_id }}">
            Add a desktop image
          </div>
        </div>
      {% endif %}

      {% if block.settings.image_mobile != blank %}
        <img
          class="ai-hero-image-mobile-{{ ai_gen_id }}"
          src="{{ block.settings.image_mobile | image_url: width: 1000 }}"
          alt="{{ block.settings.image_mobile.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_mobile.width }}"
          height="{{ block.settings.image_mobile.height }}"
        >
      {% elsif block.settings.image_desktop != blank %}
        <img
          class="ai-hero-image-mobile-{{ ai_gen_id }}"
          src="{{ block.settings.image_desktop | image_url: width: 1000 }}"
          alt="{{ block.settings.image_desktop.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_desktop.width }}"
          height="{{ block.settings.image_desktop.height }}"
        >
      {% else %}
        <div class="ai-hero-media-placeholder-{{ ai_gen_id }} ai-hero-image-mobile-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-hero-empty-state-{{ ai_gen_id }}">
            Add a mobile image
          </div>
        </div>
      {% endif %}
    {% endif %}
  </div>

  <div class="ai-hero-content-{{ ai_gen_id }}">
    <div class="ai-hero-text-wrapper-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="ai-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-hero-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}

      <div class="ai-hero-buttons-{{ ai_gen_id }}">
        {% if block.settings.button_primary_label != blank %}
          <a
            href="{{ block.settings.button_primary_link }}"
            class="ai-hero-button-{{ ai_gen_id }} ai-hero-button-primary-{{ ai_gen_id }}"
          >
            {{ block.settings.button_primary_label }}
          </a>
        {% endif %}

        {% if block.settings.button_secondary_label != blank %}
          <a
            href="{{ block.settings.button_secondary_link }}"
            class="ai-hero-button-{{ ai_gen_id }} ai-hero-button-secondary-{{ ai_gen_id }}"
          >
            {{ block.settings.button_secondary_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
