{% doc %}
  @prompt
    a constantly moving wall of fame carousel of small images, text and review, Add headline of Wall of Fame
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-wall-of-fame-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-wall-of-fame-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    padding: 0 20px;
  }

  .ai-wall-of-fame-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 700;
  }

  .ai-wall-of-fame-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    animation: ai-wall-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-wall-of-fame-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    flex-shrink: 0;
  }

  .ai-wall-of-fame-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.item_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-wall-of-fame-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f4f4f4;
  }

  .ai-wall-of-fame-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-wall-of-fame-image-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-wall-of-fame-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-wall-of-fame-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-wall-of-fame-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
    color: {{ block.settings.star_color }};
  }

  .ai-wall-of-fame-review-{{ ai_gen_id }} {
    font-size: {{ block.settings.review_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
  }

  @keyframes ai-wall-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  .ai-wall-of-fame-{{ ai_gen_id }}:hover .ai-wall-of-fame-container-{{ ai_gen_id }} {
    animation-play-state: paused;
  }

  @media screen and (max-width: 749px) {
    .ai-wall-of-fame-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-wall-of-fame-item-{{ ai_gen_id }} {
      width: {{ block.settings.item_width | times: 0.8 }}px;
    }

    .ai-wall-of-fame-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.image_height | times: 0.8 }}px;
    }
  }
{% endstyle %}

<wall-of-fame-{{ ai_gen_id }} class="ai-wall-of-fame-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <div class="ai-wall-of-fame-header-{{ ai_gen_id }}">
      <h2 class="ai-wall-of-fame-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="ai-wall-of-fame-container-{{ ai_gen_id }}">
    <div class="ai-wall-of-fame-track-{{ ai_gen_id }}">
      {% for i in (1..10) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign name_key = 'name_' | append: i
          assign review_key = 'review_' | append: i
          assign rating_key = 'rating_' | append: i

          assign item_image = block.settings[image_key]
          assign item_name = block.settings[name_key]
          assign item_review = block.settings[review_key]
          assign item_rating = block.settings[rating_key]
        %}

        {% if item_name != blank or item_review != blank or item_image != blank %}
          <div class="ai-wall-of-fame-item-{{ ai_gen_id }}">
            <div class="ai-wall-of-fame-image-wrapper-{{ ai_gen_id }}">
              {% if item_image %}
                <img
                  src="{{ item_image | image_url: width: 400 }}"
                  alt="{{ item_name | escape }}"
                  class="ai-wall-of-fame-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="400"
                  height="{{ block.settings.image_height }}"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>

            <div class="ai-wall-of-fame-content-{{ ai_gen_id }}">
              {% if item_name != blank %}
                <h3 class="ai-wall-of-fame-name-{{ ai_gen_id }}">{{ item_name }}</h3>
              {% endif %}

              {% if item_rating > 0 %}
                <div class="ai-wall-of-fame-stars-{{ ai_gen_id }}">
                  {% for star in (1..5) %}
                    {% if star <= item_rating %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                      </svg>
                    {% else %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                      </svg>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              {% if item_review != blank %}
                <p class="ai-wall-of-fame-review-{{ ai_gen_id }}">{{ item_review }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-wall-of-fame-track-{{ ai_gen_id }}" aria-hidden="true">
      {% for i in (1..10) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign name_key = 'name_' | append: i
          assign review_key = 'review_' | append: i
          assign rating_key = 'rating_' | append: i

          assign item_image = block.settings[image_key]
          assign item_name = block.settings[name_key]
          assign item_review = block.settings[review_key]
          assign item_rating = block.settings[rating_key]
        %}

        {% if item_name != blank or item_review != blank or item_image != blank %}
          <div class="ai-wall-of-fame-item-{{ ai_gen_id }}">
            <div class="ai-wall-of-fame-image-wrapper-{{ ai_gen_id }}">
              {% if item_image %}
                <img
                  src="{{ item_image | image_url: width: 400 }}"
                  alt="{{ item_name | escape }}"
                  class="ai-wall-of-fame-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="400"
                  height="{{ block.settings.image_height }}"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>

            <div class="ai-wall-of-fame-content-{{ ai_gen_id }}">
              {% if item_name != blank %}
                <h3 class="ai-wall-of-fame-name-{{ ai_gen_id }}">{{ item_name }}</h3>
              {% endif %}

              {% if item_rating > 0 %}
                <div class="ai-wall-of-fame-stars-{{ ai_gen_id }}">
                  {% for star in (1..5) %}
                    {% if star <= item_rating %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                      </svg>
                    {% else %}
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                      </svg>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              {% if item_review != blank %}
                <p class="ai-wall-of-fame-review-{{ ai_gen_id }}">{{ item_review }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</wall-of-fame-{{ ai_gen_id }}>

<script>
  (function() {
    class WallOfFame{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.container = this.querySelector('.ai-wall-of-fame-container-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.setAttribute('role', 'region');
        this.setAttribute('aria-label', 'Customer reviews carousel');
      }
    }

    customElements.define('wall-of-fame-{{ ai_gen_id }}', WallOfFame{{ ai_gen_id }});
  })();
</script>

