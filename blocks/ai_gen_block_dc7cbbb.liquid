{% doc %}
  @prompt
    Two columns with text with featured image that you can swipe, perfect, can you just add a header, can you add a second button for the second column, add a sub head after the heading and the buttons and text should be center aligned, the buttons should not be stacked, the columns should bot be stacked on mobile or desktop, the buttons also shouldn' t be stacked on mobile or desktop, make the font editable
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-two-column-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-two-column-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
  }

  .ai-two-column-subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-style: {{ block.settings.subheading_font.style }};
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  .ai-two-column-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-two-column-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-two-column-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    margin-bottom: 20px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-two-column-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-two-column-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-two-column-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-two-column-content-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-two-column-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-style: {{ block.settings.title_font.style }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
  }

  .ai-two-column-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-style: {{ block.settings.body_font.style }};
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0 0 20px;
  }

  .ai-two-column-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ai-two-column-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-style: {{ block.settings.button_font.style }};
    font-size: {{ block.settings.button_text_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-two-column-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-two-column-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_bg_color }};
    color: {{ block.settings.button_secondary_text_color }};
  }

  .ai-two-column-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_hover_bg_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-container-{{ ai_gen_id }} {
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-two-column-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-two-column-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .ai-two-column-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-two-column-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.95 }}px;
    }
  }
{% endstyle %}

<image-carousel-{{ ai_gen_id }} class="ai-two-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.subheading != blank %}
    <div class="ai-two-column-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-two-column-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="ai-two-column-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-two-column-container-{{ ai_gen_id }}">
    <div class="ai-two-column-item-{{ ai_gen_id }}">
      <div class="ai-two-column-image-wrapper-{{ ai_gen_id }}" data-carousel-wrapper>
        {% if block.settings.image_1 != blank %}
          <img
            src="{{ block.settings.image_1 | image_url: width: 800 }}"
            alt="{{ block.settings.image_1.alt | escape }}"
            class="ai-two-column-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image_1.width }}"
            height="{{ block.settings.image_1.height }}"
          >
        {% endif %}
        {% if block.settings.image_1_alt != blank %}
          <img
            src="{{ block.settings.image_1_alt | image_url: width: 800 }}"
            alt="{{ block.settings.image_1_alt.alt | escape }}"
            class="ai-two-column-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image_1_alt.width }}"
            height="{{ block.settings.image_1_alt.height }}"
          >
        {% endif %}
        {% if block.settings.image_1 == blank and block.settings.image_1_alt == blank %}
          <div class="ai-two-column-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
      <div class="ai-two-column-content-{{ ai_gen_id }}">
        {% if block.settings.title_1 != blank %}
          <h3 class="ai-two-column-title-{{ ai_gen_id }}">{{ block.settings.title_1 }}</h3>
        {% endif %}
        {% if block.settings.text_1 != blank %}
          <div class="ai-two-column-text-{{ ai_gen_id }}">{{ block.settings.text_1 }}</div>
        {% endif %}
        <div class="ai-two-column-buttons-{{ ai_gen_id }}">
          {% if block.settings.button_1_text != blank %}
            <a href="{{ block.settings.button_1_link }}" class="ai-two-column-button-{{ ai_gen_id }}">
              {{ block.settings.button_1_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="ai-two-column-item-{{ ai_gen_id }}">
      <div class="ai-two-column-image-wrapper-{{ ai_gen_id }}" data-carousel-wrapper>
        {% if block.settings.image_2 != blank %}
          <img
            src="{{ block.settings.image_2 | image_url: width: 800 }}"
            alt="{{ block.settings.image_2.alt | escape }}"
            class="ai-two-column-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image_2.width }}"
            height="{{ block.settings.image_2.height }}"
          >
        {% endif %}
        {% if block.settings.image_2_alt != blank %}
          <img
            src="{{ block.settings.image_2_alt | image_url: width: 800 }}"
            alt="{{ block.settings.image_2_alt.alt | escape }}"
            class="ai-two-column-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.image_2_alt.width }}"
            height="{{ block.settings.image_2_alt.height }}"
          >
        {% endif %}
        {% if block.settings.image_2 == blank and block.settings.image_2_alt == blank %}
          <div class="ai-two-column-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
      <div class="ai-two-column-content-{{ ai_gen_id }}">
        {% if block.settings.title_2 != blank %}
          <h3 class="ai-two-column-title-{{ ai_gen_id }}">{{ block.settings.title_2 }}</h3>
        {% endif %}
        {% if block.settings.text_2 != blank %}
          <div class="ai-two-column-text-{{ ai_gen_id }}">{{ block.settings.text_2 }}</div>
        {% endif %}
        <div class="ai-two-column-buttons-{{ ai_gen_id }}">
          {% if block.settings.button_2_text != blank %}
            <a href="{{ block.settings.button_2_link }}" class="ai-two-column-button-{{ ai_gen_id }}">
              {{ block.settings.button_2_text }}
            </a>
          {% endif %}
          {% if block.settings.button_2_secondary_text != blank %}
            <a
              href="{{ block.settings.button_2_secondary_link }}"
              class="ai-two-column-button-{{ ai_gen_id }} ai-two-column-button-secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_2_secondary_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</image-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.carouselWrappers = this.querySelectorAll('[data-carousel-wrapper]');
        this.swipeThreshold = 50;
      }

      connectedCallback() {
        this.carouselWrappers.forEach((wrapper) => {
          const images = wrapper.querySelectorAll('.ai-two-column-image-{{ ai_gen_id }}');
          if (images.length > 1) {
            this.initCarousel(wrapper, images);
          }
        });
      }

      initCarousel(wrapper, images) {
        let currentIndex = 0;
        let startX = 0;
        let isDragging = false;

        images.forEach((img, index) => {
          if (index !== 0) {
            img.style.display = 'none';
          }
        });

        const showImage = (index) => {
          images.forEach((img, i) => {
            img.style.display = i === index ? 'block' : 'none';
          });
        };

        const nextImage = () => {
          currentIndex = (currentIndex + 1) % images.length;
          showImage(currentIndex);
        };

        const prevImage = () => {
          currentIndex = (currentIndex - 1 + images.length) % images.length;
          showImage(currentIndex);
        };

        wrapper.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
          isDragging = true;
        });

        wrapper.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
        });

        wrapper.addEventListener('touchend', (e) => {
          if (!isDragging) return;
          isDragging = false;
          const endX = e.changedTouches[0].clientX;
          const diffX = startX - endX;

          if (Math.abs(diffX) > this.swipeThreshold) {
            if (diffX > 0) {
              nextImage();
            } else {
              prevImage();
            }
          }
        });

        wrapper.addEventListener('mousedown', (e) => {
          startX = e.clientX;
          isDragging = true;
          e.preventDefault();
        });

        wrapper.addEventListener('mousemove', (e) => {
          if (!isDragging) return;
        });

        wrapper.addEventListener('mouseup', (e) => {
          if (!isDragging) return;
          isDragging = false;
          const endX = e.clientX;
          const diffX = startX - endX;

          if (Math.abs(diffX) > this.swipeThreshold) {
            if (diffX > 0) {
              nextImage();
            } else {
              prevImage();
            }
          }
        });

        wrapper.addEventListener('mouseleave', () => {
          isDragging = false;
        });

        wrapper.style.cursor = 'grab';
        wrapper.addEventListener('mousedown', () => {
          wrapper.style.cursor = 'grabbing';
        });
        wrapper.addEventListener('mouseup', () => {
          wrapper.style.cursor = 'grab';
        });
      }
    }

    customElements.define('image-carousel-{{ ai_gen_id }}', ImageCarousel{{ ai_gen_id }});
  })();
</script>

