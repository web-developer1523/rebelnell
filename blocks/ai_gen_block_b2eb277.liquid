{% doc %}
  @prompt
    create a  section with three buttons align vertically on both desktop and mobile. the buttons should have a slider to move through the buttons. under the buttons I need a hero image, the buttons shouldn't stack, the buttons should be smaller and not stacked, add a fourth button, I want to be able to adjust the height and width of the image , add text and a button to the hero, I want the hero to have a black overlay that is adjustable
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-button-slider-{{ ai_gen_id }} {
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-button-slider-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-button-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    margin-bottom: {{ block.settings.spacing_below_buttons }}px;
  }

  .ai-button-slider-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 0;
  }

  .ai-button-slider-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-button-slider-item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    width: calc(100% - 40px);
  }

  .ai-button-slider-btn-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.button_padding }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
  }

  .ai-button-slider-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-button-slider-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
  }

  .ai-button-slider-nav-btn-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_icon_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-button-slider-nav-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
  }

  .ai-button-slider-nav-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-button-slider-nav-btn-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-button-slider-hero-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    display: flex;
    justify-content: center;
  }

  .ai-button-slider-hero-inner-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}%;
    max-width: 100%;
    position: relative;
  }

  .ai-button-slider-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
    object-fit: {{ block.settings.image_fit }};
  }

  .ai-button-slider-hero-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-button-slider-hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-button-slider-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-button-slider-hero-overlay-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    border-radius: {{ block.settings.image_border_radius }}px;
    pointer-events: none;
  }

  .ai-button-slider-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.content_alignment }};
    justify-content: {{ block.settings.content_vertical_alignment }};
    padding: 40px;
    text-align: {{ block.settings.text_alignment }};
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-button-slider-hero-content-{{ ai_gen_id }} {
    max-width: 600px;
    position: relative;
    z-index: 1;
  }

  .ai-button-slider-hero-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-button-slider-hero-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 24px;
    line-height: 1.5;
  }

  .ai-button-slider-hero-cta-{{ ai_gen_id }} {
    display: inline-flex;
    padding: {{ block.settings.cta_padding }}px {{ block.settings.cta_padding | times: 2 }}px;
    background-color: {{ block.settings.cta_bg_color }};
    color: {{ block.settings.cta_text_color }};
    border: {{ block.settings.cta_border_width }}px solid {{ block.settings.cta_border_color }};
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-size: {{ block.settings.cta_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-button-slider-hero-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_bg_color }};
    color: {{ block.settings.cta_hover_text_color }};
    border-color: {{ block.settings.cta_hover_border_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-button-slider-item-{{ ai_gen_id }} {
      width: auto;
      min-width: {{ block.settings.button_min_width }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-button-slider-hero-overlay-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-button-slider-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-button-slider-hero-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<button-slider-{{ ai_gen_id }} class="ai-button-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-button-slider-container-{{ ai_gen_id }}">
    <div class="ai-button-slider-wrapper-{{ ai_gen_id }}">
      <div class="ai-button-slider-track-{{ ai_gen_id }}" data-slider-track>
        {% for i in (1..4) %}
          {% liquid
            assign button_text_key = 'button_' | append: i | append: '_text'
            assign button_url_key = 'button_' | append: i | append: '_url'
            assign button_text = block.settings[button_text_key]
            assign button_url = block.settings[button_url_key]
          %}
          
          {% if button_text != blank %}
            <div class="ai-button-slider-item-{{ ai_gen_id }}">
              {% if button_url != blank %}
                <a href="{{ button_url }}" class="ai-button-slider-btn-{{ ai_gen_id }}">
                  {{ button_text }}
                </a>
              {% else %}
                <button class="ai-button-slider-btn-{{ ai_gen_id }}">
                  {{ button_text }}
                </button>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="ai-button-slider-nav-{{ ai_gen_id }}">
        <button 
          class="ai-button-slider-nav-btn-{{ ai_gen_id }}" 
          data-slider-prev
          aria-label="Previous button"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button 
          class="ai-button-slider-nav-btn-{{ ai_gen_id }}" 
          data-slider-next
          aria-label="Next button"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <div class="ai-button-slider-hero-{{ ai_gen_id }}">
      <div class="ai-button-slider-hero-inner-{{ ai_gen_id }}">
        {% if block.settings.hero_image %}
          <img
            src="{{ block.settings.hero_image | image_url: width: 2000 }}"
            alt="{{ block.settings.hero_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.hero_image.width }}"
            height="{{ block.settings.hero_image.height }}"
            class="ai-button-slider-hero-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-button-slider-hero-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-button-slider-empty-state-{{ ai_gen_id }}">
              Add a hero image
            </div>
          </div>
        {% endif %}

        <div class="ai-button-slider-hero-overlay-bg-{{ ai_gen_id }}"></div>

        <div class="ai-button-slider-hero-overlay-{{ ai_gen_id }}">
          <div class="ai-button-slider-hero-content-{{ ai_gen_id }}">
            {% if block.settings.hero_heading != blank %}
              <h2 class="ai-button-slider-hero-heading-{{ ai_gen_id }}">
                {{ block.settings.hero_heading }}
              </h2>
            {% endif %}

            {% if block.settings.hero_text != blank %}
              <div class="ai-button-slider-hero-text-{{ ai_gen_id }}">
                {{ block.settings.hero_text }}
              </div>
            {% endif %}

            {% if block.settings.hero_cta_text != blank %}
              {% if block.settings.hero_cta_url != blank %}
                <a href="{{ block.settings.hero_cta_url }}" class="ai-button-slider-hero-cta-{{ ai_gen_id }}">
                  {{ block.settings.hero_cta_text }}
                </a>
              {% else %}
                <button class="ai-button-slider-hero-cta-{{ ai_gen_id }}">
                  {{ block.settings.hero_cta_text }}
                </button>
              {% endif %}
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</button-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ButtonSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('[data-slider-track]');
        this.prevBtn = this.querySelector('[data-slider-prev]');
        this.nextBtn = this.querySelector('[data-slider-next]');
        this.items = this.querySelectorAll('.ai-button-slider-item-{{ ai_gen_id }}');
        this.currentIndex = 0;

        if (this.prevBtn && this.nextBtn && this.track) {
          this.setupEventListeners();
          this.updateButtons();
        }
      }

      setupEventListeners() {
        this.prevBtn.addEventListener('click', () => this.slidePrev());
        this.nextBtn.addEventListener('click', () => this.slideNext());
        
        this.track.addEventListener('scroll', () => {
          this.updateCurrentIndex();
          this.updateButtons();
        });
      }

      slidePrev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.scrollToIndex(this.currentIndex);
        }
      }

      slideNext() {
        if (this.currentIndex < this.items.length - 1) {
          this.currentIndex++;
          this.scrollToIndex(this.currentIndex);
        }
      }

      scrollToIndex(index) {
        const item = this.items[index];
        if (item) {
          item.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
        }
      }

      updateCurrentIndex() {
        const scrollLeft = this.track.scrollLeft;
        const itemWidth = this.items[0].offsetWidth;
        this.currentIndex = Math.round(scrollLeft / itemWidth);
      }

      updateButtons() {
        if (this.prevBtn && this.nextBtn) {
          this.prevBtn.disabled = this.currentIndex === 0;
          this.nextBtn.disabled = this.currentIndex === this.items.length - 1;
        }
      }
    }

    customElements.define('button-slider-{{ ai_gen_id }}', ButtonSlider{{ ai_gen_id }});
  })();
</script>

