{% doc %}
  @prompt
    A rich text block with the following customizable settings in the theme editor: background color, text color, font size (px), line height, letter spacing (em), top/bottom padding, left/right padding, and max-width for the block container. Include a heading field, a body text field, and an optional CTA link with custom label and URL. Mobile responsive., A rich text block with the following customizable settings in the theme editor: background color, text color, font size (px), line height, letter spacing (em), top/bottom padding, left/right padding, and max-width for the block container. The background color must span the full width of the page, not just the content area. Text alignment should be adjustable (left, center, right). Include a heading field, a body text field, and an optional CTA link with custom label and URL. Mobile responsive.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-rich-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px 0;
  }

  .ai-rich-text-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.padding_left_right }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-rich-text-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size }}px;
    line-height: {{ block.settings.line_height }};
    letter-spacing: {{ block.settings.letter_spacing }}em;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-rich-text-heading-{{ ai_gen_id }} {
    margin: 0 0 20px 0;
    color: {{ block.settings.text_color }};
  }

  .ai-rich-text-body-{{ ai_gen_id }} {
    margin: 0;
  }

  .ai-rich-text-body-{{ ai_gen_id }} p {
    margin: 0 0 1em 0;
  }

  .ai-rich-text-body-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-rich-text-cta-{{ ai_gen_id }} {
    margin-top: 24px;
  }

  .ai-rich-text-cta-link-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 24px;
    background-color: {{ block.settings.cta_background_color }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .ai-rich-text-cta-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_background_color }};
    color: {{ block.settings.cta_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-rich-text-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 0 {{ block.settings.padding_bottom | times: 0.7 }}px 0;
    }

    .ai-rich-text-container-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.padding_left_right | times: 0.7 }}px;
    }

    .ai-rich-text-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<ai-rich-text-{{ ai_gen_id }} class="ai-rich-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-rich-text-container-{{ ai_gen_id }}">
    <div class="ai-rich-text-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <div class="ai-rich-text-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </div>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-rich-text-body-{{ ai_gen_id }}">
          {{ block.settings.body_text }}
        </div>
      {% endif %}

      {% if block.settings.cta_label != blank and block.settings.cta_url != blank %}
        <div class="ai-rich-text-cta-{{ ai_gen_id }}">
          <a href="{{ block.settings.cta_url }}" class="ai-rich-text-cta-link-{{ ai_gen_id }}">
            {{ block.settings.cta_label }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</ai-rich-text-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Rich text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Rich text heading</p>"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "cta_background_color",
      "label": "Button background",
      "default": "#c81688"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cta_hover_background_color",
      "label": "Button hover background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "cta_hover_text_color",
      "label": "Button hover text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "cta_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "line_height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "label": "Line height",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 0.5,
      "step": 0.1,
      "unit": "em",
      "label": "Letter spacing",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left_right",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Left/right padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 400,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Max width",
      "default": 800
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
