{% doc %}
  @prompt
    a featured collection with one large image and several small images around it to help tell the story of the collection better. make the collection images include  add to cart and a button on the featured image of the section that say shop all, can you remove some of the white space in the top and have the products scrolling below the main image, this is perfect just remove the side images. Put the text over the image, add the products for the collection below the featured collection that are scrollable and include add to cart, i want to be able to edit the alignment of all the text, I want to be able to put the text in the hero image to the bottom center of the image in both mobile and desktop. the product text should be center aligned.and when people click in the picture,it send them to the product page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    width: 100%;
    display: block;
  }

  .ai-featured-collection-hero-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
  }

  .ai-featured-collection-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-featured-collection-hero-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .ai-featured-collection-hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-collection-hero-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.text_vertical_position }}%;
    left: 50%;
    transform: translateX(-50%);
    text-align: {{ block.settings.text_alignment }};
    width: 90%;
    max-width: 600px;
    z-index: 2;
  }

  .ai-featured-collection-hero-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
    font-weight: 700;
  }

  .ai-featured-collection-hero-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 20px;
    line-height: 1.5;
  }

  .ai-featured-collection-hero-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 30px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-featured-collection-hero-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-featured-collection-products-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 40px auto 0;
    overflow: hidden;
  }

  .ai-featured-collection-products-scroll-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding-bottom: 20px;
    -webkit-overflow-scrolling: touch;
  }

  .ai-featured-collection-products-scroll-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 8px;
  }

  .ai-featured-collection-products-scroll-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 4px;
  }

  .ai-featured-collection-products-scroll-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 4px;
  }

  .ai-featured-collection-products-scroll-{{ ai_gen_id }}::-webkit-scrollbar-thumb:hover {
    background: #555;
  }

  .ai-featured-collection-product-card-{{ ai_gen_id }} {
    flex: 0 0 250px;
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .ai-featured-collection-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    margin-bottom: 12px;
    overflow: hidden;
    border-radius: {{ block.settings.product_image_border_radius }}px;
  }

  .ai-featured-collection-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-featured-collection-product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-collection-product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-featured-collection-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_text_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-featured-collection-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_text_color }};
    margin: 0 0 12px;
  }

  .ai-featured-collection-add-to-cart-{{ ai_gen_id }} {
    padding: 10px 20px;
    background-color: {{ block.settings.add_to_cart_bg_color }};
    color: {{ block.settings.add_to_cart_text_color }};
    border: none;
    border-radius: {{ block.settings.add_to_cart_border_radius }}px;
    font-size: {{ block.settings.add_to_cart_text_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
    width: 100%;
  }

  .ai-featured-collection-add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.add_to_cart_hover_bg_color }};
  }

  .ai-featured-collection-add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection-hero-content-{{ ai_gen_id }} {
      bottom: {{ block.settings.text_vertical_position_mobile }}%;
    }

    .ai-featured-collection-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-featured-collection-hero-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.85 }}px;
    }

    .ai-featured-collection-product-card-{{ ai_gen_id }} {
      flex: 0 0 180px;
    }
  }
{% endstyle %}

<featured-collection-{{ ai_gen_id }} class="ai-featured-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-collection-hero-{{ ai_gen_id }}">
    {% if block.settings.hero_image %}
      <img
        src="{{ block.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ block.settings.hero_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.hero_image.width }}"
        height="{{ block.settings.hero_image.height }}"
        class="ai-featured-collection-hero-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-featured-collection-hero-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    <div class="ai-featured-collection-hero-content-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-featured-collection-hero-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-featured-collection-hero-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      {% if block.settings.collection != blank %}
        <a href="{{ block.settings.collection.url }}" class="ai-featured-collection-hero-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>

  {% if block.settings.collection != blank %}
    <div class="ai-featured-collection-products-{{ ai_gen_id }}">
      <div class="ai-featured-collection-products-scroll-{{ ai_gen_id }}">
        {% for product in block.settings.collection.products limit: block.settings.products_limit %}
          <div class="ai-featured-collection-product-card-{{ ai_gen_id }}">
            <a href="{{ product.url }}" class="ai-featured-collection-product-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 500 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="500"
                  height="500"
                  class="ai-featured-collection-product-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-featured-collection-product-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>

            <h3 class="ai-featured-collection-product-title-{{ ai_gen_id }}">
              <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">{{ product.title }}</a>
            </h3>

            <div class="ai-featured-collection-product-price-{{ ai_gen_id }}">
              {{ product.price | money }}
            </div>

            <button
              class="ai-featured-collection-add-to-cart-{{ ai_gen_id }}"
              data-product-id="{{ product.id }}"
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
              {% unless product.available %}disabled{% endunless %}
            >
              {% if product.available %}
                {{ block.settings.add_to_cart_text }}
              {% else %}
                Sold out
              {% endif %}
            </button>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</featured-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.addToCartButtons = this.querySelectorAll('.ai-featured-collection-add-to-cart-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.addToCartButtons.forEach((button) => {
          button.addEventListener('click', this.handleAddToCart.bind(this));
        });
      }

      async handleAddToCart(event) {
        const button = event.target;
        const variantId = button.dataset.variantId;
        const originalText = button.textContent;

        button.disabled = true;
        button.textContent = 'Adding...';

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: 1,
            }),
          });

          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }

          button.textContent = 'Added!';

          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);

          const cartCountElements = document.querySelectorAll('[data-cart-count]');
          const cartResponse = await fetch('/cart.js');
          const cart = await cartResponse.json();
          
          cartCountElements.forEach((element) => {
            element.textContent = cart.item_count;
          });

          if (window.theme && window.theme.cart) {
            window.theme.cart.getCart();
          }

        } catch (error) {
          console.error('Error adding to cart:', error);
          button.textContent = 'Error';
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);
        }
      }
    }

    customElements.define('featured-collection-{{ ai_gen_id }}', FeaturedCollection{{ ai_gen_id }});
  })();
</script>

