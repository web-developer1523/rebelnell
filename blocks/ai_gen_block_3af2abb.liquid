<script>
  (function() {
    class ParallelSections{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupDropdowns();
      }

      setupDropdowns() {
        const dropdownTriggers = this.querySelectorAll('[data-dropdown]');
        
        dropdownTriggers.forEach(trigger => {
          trigger.addEventListener('click', () => {
            const dropdownId = trigger.getAttribute('data-dropdown');
            const dropdown = this.querySelector(`#${dropdownId}`);
            
            const isActive = dropdown.classList.contains('active');
            
            this.querySelectorAll('.ai-dropdown-{{ ai_gen_id }}').forEach(d => {
              d.classList.remove('active');
            });
            
            if (!isActive) {
              dropdown.classList.add('active');
            }
          });
        });

        document.addEventListener('click', (event) => {
          if (!event.target.closest('.ai-item-{{ ai_gen_id }}')) {
            this.querySelectorAll('.ai-dropdown-{{ ai_gen_id }}').forEach(dropdown => {
              dropdown.classList.remove('active');
            });
          }
        });
      }
    }

    customElements.define('parallel-sections-{{ ai_gen_id }}', ParallelSections{{ ai_gen_id }});
  })();
</script>

