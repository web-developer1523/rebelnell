      if ($grid.hasClass('slick-initialized')) {
        $grid.slick('unslick');
      }
    }
  }

  $(document).ready(function() {
    initResponsiveSlider();
    $(window).on('resize', function() {
      initResponsiveSlider();
    });
  });
</script> {% endcomment %}

