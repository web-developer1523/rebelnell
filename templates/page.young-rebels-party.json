    "rich_text_Mqhjw9": {
      "type": "rich-text",
      "blocks": {
        "heading_TWLdWk": {
          "type": "heading",
          "settings": {
            "title": "A One-of-a-Kind Kids Birthday Party Experience in Detroit",
            "heading_size": "h2"
          }
        },
        "text_ehzBcG": {
          "type": "text",
          "settings": {
            "enlarge_text": true,
            "text": "<p><strong>Looking for unique kids birthday party ideas in Detroit?</strong> Meet the ultimate celebration for the young rebels — a birthday party that honors individuality, creativity, and self-expression.This isn’t just a party. It’s a bold statement: You are one of a kind — and that’s worth celebrating.</p><p><strong>🎉 What Makes This Party So Different?</strong> Forget cookie-cutter themes. This experience is designed to spotlight what makes each child special. </p><p><strong>Here’s how: </strong>Empower Each Guest. Every child is recognized for who they are. Through thoughtful activities and guided reflection, each guest gets a moment to shine — no one fades into the background but the birthday guest is celebrated with honor.</p><p><strong>Craft a Personalized Gift</strong>: The crown jewel of the party: a hands-on creative session where each child designs their own unique talisman. Think of it as a wearable symbol of their superpowers — courage, kindness, creativity, you name it. It’s fun, meaningful, and something they’ll actually want to keep.</p><p><strong>Detroit-Based, Fun-filled and Creativity Packed, this experience is crafted for kids— and for parents who want a memorable birthday for their kids.</strong><br/></p>"
          }
        }
      },
