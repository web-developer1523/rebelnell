        "ai_gen_block_3831cc0_iLQpD8": {
          "type": "ai_gen_block_3831cc0",
          "settings": {
            "heading": "Wall of Fame",
            "heading_size": 36,
            "heading_color": "#000000",
            "desktop_width_percent": 100,
            "background_color": "#ffffff",
            "card_width": 280,
            "card_spacing": 10,
            "card_background": "#ffffff",
            "card_border_radius": 12,
            "name_size": 16,
            "review_size": 14,
            "text_color": "#000000",
            "show_stars": true,
            "star_color": "#c81688",
            "button_color": "#c81688",
            "button_hover_color": "#000000",
            "button_text_color": "#ffffff",
            "scrollbar_color": "#c81688",
            "review_1_enabled": true,
            "review_1_image": "shopify://shop_images/inforum.jpg",
            "review_1_name": "Inforum 20th Anniversary",
            "review_1_text": "One of my favorite elements of the evening was the Rebel Nell graffiti board! What a cool and creative way to capture everyone’s ideas and words of what Inforum means to them. - Mary G.",
            "review_1_rating": 5,
            "review_2_enabled": true,
            "review_2_image": "shopify://shop_images/Troy.jpg",
            "review_2_name": "Troy Chamber Networking",
            "review_2_text": "The Rebel Nell mural-making experience brought our team together in such a meaningful way. It was amazing to see everyone collaborate and express themselves, and the final reveal was truly inspiring. Having the mural repurposed into keepsakes made the experience even more special and long-lasting. - Tara T.",
            "review_2_rating": 5,
            "review_3_enabled": true,
            "review_3_image": "shopify://shop_images/PXL_20240308_014501340.jpg",
            "review_3_name": "Ally Bank x Detroit Pistons",
            "review_3_text": "We brought in Rebel Nell to create a fan experience for International Women’s Day at the Detroit Pistons. Hundreds of fans added their voices to the mural experience and what resulted was an amazing work of art. We turned the remnants into collectible pins which ensured the message kept living long after the game. For us at Ally, that’s impact you can measure in both numbers and smiles.- Andrea B.",
            "review_3_rating": 5,
            "review_4_enabled": true,
            "review_4_image": "shopify://shop_images/IMG_3162_1.heic",
            "review_4_name": "Independent Bank",
            "review_4_text": "Partnering with Rebel Nell on the mural experience was a unique way to bring our employees and community members together... It was such a meaningful reminder that community is at the core of our business. We can’t recommend this experience enough! - Lane S.",
            "review_4_rating": 5,
            "review_5_enabled": true,
            "review_5_image": "shopify://shop_images/IMG_3852_1.heic",
            "review_5_name": "GBC Conference",
            "review_5_text": "Rebel Nell’s mini mural activation was a delight at our conference experience. It brought creativity, humanity, and storytelling into a business setting. The engagement, energy, and conversation it sparked among leaders during our Global Business Banking summit was remarkable and everyone left with their own personal mural created from the reflections they had throughout the day.  A great way to remind them all year of the work we did at the event. We would absolutely partner with them again. - Sara P.",
            "review_5_rating": 5,
            "review_6_enabled": true,
            "review_6_image": "shopify://shop_images/IMG_3059.heic",
            "review_6_name": "Detroit Tigers",
            "review_6_text": "Creating the mural together with the Detroit Tigers significant others was such a powerful way to connect — everyone brought their own touch, and together it told a bigger story about their love for the community and team. Designing our own jewelry gave us something personal to take home, but the real takeaway was the memories we made and the bonds we built through this enriching experience.",
            "review_6_rating": 5,
            "review_7_enabled": true,
            "review_7_image": "shopify://shop_images/PXL_20260309_153554801.jpg",
            "review_7_name": "ACES",
