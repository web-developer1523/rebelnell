    "rich_text_d9jwP7": {
      "type": "rich-text",
      "blocks": {
        "heading_UPdxtf": {
          "type": "heading",
          "settings": {
            "title": "Why Choose Rebel Nell for Your Corporate Gifting & Promotional Item Needs?",
            "heading_size": "h2"
          }
        },
        "text_wygjLz": {
          "type": "text",
          "settings": {
            "enlarge_text": true,
            "text": "<p>- <strong>Sustainable and Eco-friendly:</strong> Our products are made with sustainability at heart, ensuring they don't contribute to landfill waste.<br/>- <strong>Social Impact:</strong> We empower women through employment and education, turning local materials into beautiful, one-of-a-kind pieces.<br/>- <strong>Reflect Your Values:</strong> Our gifts are a testament to your company’s commitment to social responsibility and environmental care.<br/><br/>Join us in the rebellion against bland corporate gifting. Let your company values shine through with every gift you give. Choose Rebel Nell for corporate gifts that matter. To read more about our Corporate Gifting visit our blog.</p>"
          }
        }
      },
      "block_order": [
