        "liquid_8ktPUm": {
          "type": "liquid",
          "settings": {
            "code": "<h2>T.E.A. 501c3</h2><p>T.E.A. (Teach Empower Achieve) is a 501c3 workforce development organization that serves as a partner for people, primarily women, facing barriers to employment and aims to be a driver of equitable change. T.E.A. works in close collaboration with existing businesses to identify employment needs and job development solutions that support and provide resources for participants’ pathways toward self-sufficiency.\n</b></p>\n<a type=\"button\" class=\"btn btn-link mb-3\" href=\"https://www.rebelnell.com/blogs/blog/the-tea-on-teach-empower-achieve\">Learn More</a>",
            "width": "66%",
            "alignment": "center"
          }
        }
      },
      "block_order": [
