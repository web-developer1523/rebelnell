    "advanced_content_U9N8kW": {
      "type": "advanced-content",
      "blocks": {
        "image_MQKKkz": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/GLIMMER_IN_THE_DARK_1.png",
            "link": "",
