          "type": "text_block",
          "settings": {
            "enable_image": true,
            "image": "shopify://shop_images/D212BDC1-6114-457B-B7D7-1132EF76A3FE.jpg",
            "image_mask": "none",
            "image_width": 650,
            "title": "Bottle Stoppers",
            "text": "<p>Custom bottle stoppers using the company colors for the graffiti and engraved on the back. This made for a perfect holiday gifts for clients. </p>",
            "button_label": "",
