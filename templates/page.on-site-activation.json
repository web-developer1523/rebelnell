          }
        },
        "text_block_GhtybX": {
          "type": "text_block",
          "settings": {
            "enable_image": true,
            "image": "shopify://shop_images/F90A2042-5B8D-421C-82BA-4564B044C88B_1.jpg",
            "image_mask": "none",
            "image_width": 650,
            "title": "Ornament",
            "text": "<p>Custom ornament made for the centennial celebration for Downtown Detroit Partnership. The logo incorporated graffiti in the colors of the organization. </p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "text_block_efP3pX": {
          "type": "text_block",
          "settings": {
            "enable_image": true,
            "image": "shopify://shop_images/PhotoRoom_000_20230315_143446.jpg",
            "image_mask": "none",
            "image_width": 650,
            "title": "Custom Bracelets",
            "text": "<p>Created in partnership with DTE to celebrate the young women at Munger school who participated in a STEM program. The bracelets are made from DTE vests provided by the Company.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "text_block_iWnjhH": {
          "type": "text_block",
          "settings": {
            "enable_image": true,
            "image": "shopify://shop_images/Custom_notebook_Slide_4_1.jpg",
            "image_mask": "none",
            "image_width": 650,
            "title": "Custom Journals",
